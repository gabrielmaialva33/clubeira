<PlatformComponents.shell
  account_scope={@current_account_scope}
  access={@platform_access}
  flash={@flash}
  active_section={:billing}
>
  <div id="platform-billing-plans-page" class="mx-auto max-w-[1500px]">
    <header>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
        {gettext("Global billing")}
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] text-slate-950 sm:text-4xl">
        {gettext("Platform plans")}
      </h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-slate-500">
        {gettext(
          "Publish immutable SaaS versions and inspect every feature and price, including future commercial periods."
        )}
      </p>
    </header>

    <section class="mt-7 rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:p-6">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <h2 class="text-lg font-black text-slate-950">{gettext("Publish plan version")}</h2>
          <p class="mt-1 text-sm leading-6 text-slate-500">
            {gettext("The version, typed features and price are committed atomically.")}
          </p>
        </div>
        <span class="rounded-full bg-blue-50 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide text-blue-700">
          {gettext("Immutable history")}
        </span>
      </div>

      <datalist id="platform-feature-options">
        <option :for={feature <- @known_features} value={feature.key}>
          {feature.name}
        </option>
      </datalist>

      <.form
        for={@publish_form}
        id="platform-plan-publish-form"
        phx-change="validate_plan"
        phx-submit="publish_plan"
        class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4"
      >
        <.input
          field={@identity_form[:code]}
          id="platform-plan-code"
          type="text"
          label={gettext("Plan code")}
          placeholder="growth"
          minlength="2"
          maxlength="80"
          pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
          required
        />
        <.input
          field={@identity_form[:version]}
          id="platform-plan-version"
          type="number"
          label={gettext("Version")}
          min="1"
          required
        />
        <.input field={@publish_form[:name]} type="text" label={gettext("Plan name")} required />
        <.input
          field={@publish_form[:version_name]}
          type="text"
          label={gettext("Version name")}
          required
        />

        <div class="sm:col-span-2 xl:col-span-4">
          <.input
            field={@publish_form[:description]}
            type="textarea"
            label={gettext("Description")}
            minlength="3"
            maxlength="5000"
            required
          />
        </div>

        <.input
          field={@publish_form[:currency]}
          type="select"
          label={gettext("Currency")}
          options={[{"BRL", "BRL"}]}
        />
        <.input
          field={@publish_form[:amount]}
          type="number"
          label={gettext("Price")}
          min="0"
          step="0.01"
          required
        />
        <.input
          field={@publish_form[:billing_interval_unit]}
          type="select"
          label={gettext("Billing interval")}
          options={[
            {gettext("Month"), "month"},
            {gettext("Year"), "year"}
          ]}
        />
        <.input
          field={@publish_form[:billing_interval_count]}
          type="number"
          label={gettext("Interval count")}
          min="1"
          max="32767"
          required
        />
        <.input
          field={@publish_form[:valid_from]}
          type="datetime-local"
          label={gettext("Price valid from")}
          required
        />
        <.input
          field={@publish_form[:valid_until]}
          type="datetime-local"
          label={gettext("Price valid until")}
          required
        />

        <fieldset class="sm:col-span-2 xl:col-span-4">
          <div class="flex items-center justify-between gap-3">
            <legend class="text-xs font-bold text-slate-700">{gettext("Typed features")}</legend>
            <button
              id="add-platform-plan-feature"
              type="button"
              phx-click="add_plan_feature"
              class="inline-flex h-9 items-center gap-2 rounded-lg border border-blue-200 bg-blue-50 px-3 text-xs font-bold text-blue-700 transition hover:bg-blue-100"
            >
              <.icon name="hero-plus" class="size-4" />
              {gettext("Add feature")}
            </button>
          </div>

          <div id="platform-plan-features" class="mt-3 grid gap-3">
            <.inputs_for :let={feature_form} field={@publish_form[:features]}>
              <div
                id={"platform-plan-feature-#{feature_form.index}"}
                class="grid gap-3 rounded-xl bg-slate-50 p-4 ring-1 ring-inset ring-slate-200 sm:grid-cols-2 xl:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_minmax(0,.7fr)_minmax(0,.7fr)_auto] xl:items-end"
              >
                <.input
                  field={feature_form[:key]}
                  type="text"
                  label={gettext("Feature key")}
                  list="platform-feature-options"
                  pattern="[a-z0-9]+(?:_[a-z0-9]+)*"
                  minlength="2"
                  maxlength="80"
                  required
                />
                <.input
                  field={feature_form[:name]}
                  type="text"
                  label={gettext("Feature name")}
                  minlength="2"
                  maxlength="160"
                  required
                />
                <.input
                  field={feature_form[:value_kind]}
                  type="select"
                  label={gettext("Value type")}
                  options={[
                    {gettext("Integer"), "integer"},
                    {gettext("Boolean"), "boolean"}
                  ]}
                />
                <.input
                  :if={feature_form[:value_kind].value == "integer"}
                  field={feature_form[:integer_value]}
                  type="number"
                  label={gettext("Value")}
                  min="0"
                  required
                />
                <.input
                  :if={feature_form[:value_kind].value == "boolean"}
                  field={feature_form[:boolean_value]}
                  type="checkbox"
                  label={gettext("Enabled")}
                />
                <button
                  id={"remove-platform-plan-feature-#{feature_form.index}"}
                  type="button"
                  phx-click="remove_plan_feature"
                  phx-value-index={feature_form.index}
                  class="mb-4 inline-flex h-10 items-center justify-center rounded-lg border border-red-200 px-3 text-xs font-bold text-red-700 transition hover:bg-red-50"
                >
                  {gettext("Remove")}
                </button>
              </div>
            </.inputs_for>
          </div>
        </fieldset>

        <div class="flex items-end justify-end sm:col-span-2 xl:col-span-4">
          <button
            id="publish-platform-plan"
            type="submit"
            phx-disable-with={gettext("Publishing...")}
            class="inline-flex h-11 items-center justify-center rounded-xl bg-blue-600 px-6 text-sm font-bold text-white shadow-[0_10px_24px_rgba(37,99,235,.2)] transition hover:bg-blue-700"
          >
            {gettext("Publish plan version")}
          </button>
        </div>
      </.form>
    </section>

    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]">
      <div class="flex flex-col gap-2 border-b border-slate-100 px-5 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <div>
          <h2 class="text-lg font-black text-slate-950">{gettext("Managed inventory")}</h2>
          <p class="mt-1 text-sm text-slate-500">
            {gettext(
              "All immutable versions are shown, regardless of current purchase eligibility."
            )}
          </p>
        </div>
        <span class="text-xs font-bold text-slate-400">
          {ngettext("Up to %{count} plan", "Up to %{count} plans", @page.limit,
            count: @page.limit
          )}
        </span>
      </div>

      <div id="managed-platform-plans" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="managed-platform-plans-empty"
          class="hidden only:flex items-center gap-3 px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-banknotes" class="size-5 text-slate-300" />
          {gettext("No platform plans have been published yet.")}
        </div>

        <article
          :for={{id, plan} <- @streams.plans}
          id={id}
          data-plan-code={plan.code}
          class="px-5 py-6 sm:px-6"
        >
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <h3 class="truncate text-lg font-black text-slate-950">{plan.name}</h3>
              <p class="mt-1 truncate font-mono text-xs text-slate-400">{plan.code}</p>
            </div>
            <span
              data-status={plan.status}
              class="w-fit rounded-full bg-blue-50 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide text-blue-700"
            >
              {status_label(plan.status)}
            </span>
          </div>

          <div class="mt-5 grid gap-4 xl:grid-cols-2">
            <section
              :for={version <- plan.versions}
              id={"managed-platform-plan-version-#{version.id}"}
              data-plan-version={version.version}
              class="rounded-xl border border-slate-200 bg-slate-50/70 p-4"
            >
              <div class="flex flex-wrap items-start justify-between gap-3">
                <div>
                  <p class="text-sm font-black text-slate-950">{version.name}</p>
                  <p class="mt-1 text-xs text-slate-500">
                    {gettext("Version %{version}", version: version.version)}
                  </p>
                </div>
                <span
                  data-version-status={version.status}
                  class="rounded-full bg-orange-50 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-orange-700"
                >
                  {status_label(version.status)}
                </span>
              </div>

              <p class="mt-3 text-sm leading-6 text-slate-600">{version.description}</p>

              <div class="mt-4 grid gap-3 sm:grid-cols-2">
                <div class="rounded-lg bg-white p-3 ring-1 ring-inset ring-slate-200">
                  <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">
                    {gettext("Features")}
                  </p>
                  <ul class="mt-2 space-y-2">
                    <li
                      :for={feature <- version.features}
                      data-feature-key={feature.key}
                      class="flex items-start justify-between gap-3 text-xs"
                    >
                      <span class="text-slate-600">{feature.name}</span>
                      <span class="font-bold text-slate-950">{feature_value(feature)}</span>
                    </li>
                  </ul>
                </div>

                <div class="rounded-lg bg-white p-3 ring-1 ring-inset ring-slate-200">
                  <p class="text-[10px] font-bold uppercase tracking-wide text-slate-400">
                    {gettext("Prices")}
                  </p>
                  <div class="mt-2 space-y-3">
                    <div
                      :for={price <- version.prices}
                      id={"managed-platform-price-#{price.id}"}
                      data-price-amount={price.amount}
                    >
                      <p class="text-sm font-black text-slate-950">
                        {price.currency} {price.amount}
                      </p>
                      <p class="mt-1 text-xs text-slate-500">{price_period(price)}</p>
                      <p class="mt-1 text-[10px] text-slate-400">
                        {gettext("%{from} to %{until}",
                          from: date_label(price.valid_during.lower),
                          until: date_label(price.valid_during.upper)
                        )}
                      </p>
                    </div>
                  </div>
                </div>
              </div>
            </section>
          </div>
        </article>
      </div>
    </section>

    <nav
      :if={@next_page_path}
      id="managed-platform-plans-pagination"
      class="mt-5 flex justify-end"
    >
      <.link
        id="managed-platform-plans-next-page"
        patch={@next_page_path}
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-bold text-white"
      >
        {gettext("Next page")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </nav>
  </div>
</PlatformComponents.shell>
