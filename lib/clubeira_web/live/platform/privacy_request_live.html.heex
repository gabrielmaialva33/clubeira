<PlatformComponents.shell
  account_scope={@current_account_scope}
  access={@platform_access}
  flash={@flash}
  active_section={:privacy}
>
  <div
    id="platform-privacy-request-page"
    data-status={@request.status}
    class="mx-auto max-w-[1200px]"
  >
    <header>
      <.link
        id="privacy-requests-back"
        navigate={~p"/platform/privacy/requests"}
        class="inline-flex items-center gap-2 text-sm font-bold text-blue-700 transition hover:text-blue-900"
      >
        <.icon name="hero-arrow-left" class="size-4" />
        {gettext("Privacy requests")}
      </.link>

      <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
            {gettext("Data-subject request")}
          </p>
          <h1 class="mt-2 text-3xl font-black capitalize tracking-[-0.045em] text-slate-950 sm:text-4xl">
            {humanized(@request.request_type)}
          </h1>
          <p class="mt-2 text-sm text-slate-500">
            {gettext("Received %{at}", at: timestamp(@request.inserted_at, @locale))}
          </p>
        </div>

        <span class="w-fit rounded-full bg-blue-50 px-4 py-2 text-xs font-black uppercase tracking-wide text-blue-700">
          {humanized(@request.status)}
        </span>
      </div>
    </header>

    <div class="mt-7 grid gap-6 xl:grid-cols-[minmax(0,1fr)_minmax(320px,0.55fr)]">
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <div class="border-b border-slate-100 px-5 py-5 sm:px-6">
          <h2 class="text-lg font-black text-slate-950">{gettext("Request timeline")}</h2>
          <p class="mt-1 text-sm text-slate-500">
            {gettext("Immutable lifecycle evidence recorded by the platform.")}
          </p>
        </div>

        <div id="privacy-request-events" phx-update="stream" class="divide-y divide-slate-100">
          <article
            :for={{id, event} <- @streams.events}
            id={id}
            class="flex gap-4 px-5 py-5 sm:px-6"
          >
            <span class="mt-1 grid size-8 shrink-0 place-items-center rounded-full bg-blue-50 text-blue-600">
              <.icon name="hero-check" class="size-4" />
            </span>
            <div>
              <p class="text-sm font-black capitalize text-slate-900">
                {humanized(event.event_type)}
              </p>
              <p class="mt-1 text-xs text-slate-400">
                {timestamp(event.occurred_at, @locale)}
              </p>
            </div>
          </article>
        </div>
      </section>

      <aside class="space-y-6">
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:p-6">
          <h2 class="text-lg font-black text-slate-950">{gettext("Deadline")}</h2>
          <p class="mt-2 text-sm font-bold text-slate-700">
            {timestamp(@request.due_at, @locale)}
          </p>
          <p :if={@request.completed_at} class="mt-3 text-xs text-emerald-700">
            {gettext("Completed %{at}", at: timestamp(@request.completed_at, @locale))}
          </p>
        </section>

        <section
          :if={@available_actions != []}
          id="privacy-request-actions"
          class="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:p-6"
        >
          <h2 class="text-lg font-black text-slate-950">{gettext("Next action")}</h2>
          <p class="mt-1 text-sm leading-6 text-slate-500">
            {gettext("Only transitions allowed by the current lifecycle are offered.")}
          </p>

          <.form
            for={@transition_form}
            id="privacy-request-transition-form"
            phx-submit="transition"
            class="mt-5"
          >
            <.input
              field={@transition_form[:action]}
              type="select"
              label={gettext("Action")}
              options={[
                {gettext("Select an action"), ""}
                | Enum.map(@available_actions, &{action_label(&1), &1})
              ]}
              required
            />
            <.input
              field={@transition_form[:rejection_reason]}
              type="textarea"
              label={gettext("Rejection reason")}
              minlength="3"
              maxlength="500"
            />

            <button
              id="privacy-request-transition-submit"
              type="submit"
              phx-disable-with={gettext("Saving...")}
              class="inline-flex h-11 w-full items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-black text-white shadow-[0_10px_24px_rgba(37,99,235,.2)] transition hover:bg-blue-700 disabled:cursor-wait disabled:opacity-70"
            >
              {gettext("Save transition")}
            </button>
          </.form>
        </section>

        <section
          :if={@available_actions == []}
          id="privacy-request-terminal"
          class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5 text-sm text-emerald-800"
        >
          {gettext("This request has reached a terminal state.")}
        </section>
      </aside>
    </div>
  </div>
</PlatformComponents.shell>
