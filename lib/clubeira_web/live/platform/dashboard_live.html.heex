<PlatformComponents.shell
  account_scope={@current_account_scope}
  access={@platform_access}
  flash={@flash}
  active_section={:overview}
>
  <div id="platform-dashboard" class="mx-auto max-w-[1500px]">
    <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="clubeira-page-kicker">
          {gettext("Global administration")}
        </div>
        <h1 class="clubeira-page-title mt-1.5">
          {gettext("Platform overview")}
        </h1>
        <p class="clubeira-page-copy mt-1.5">
          {gettext("Operate Clubeira's global capabilities without entering a tenant context.")}
        </p>
      </div>
      <div class="inline-flex w-fit items-center gap-2 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-700">
        <span class="size-2 rounded-full bg-emerald-500" />
        {gettext("Control plane online")}
      </div>
    </section>

    <section class="mt-7 grid gap-4 md:grid-cols-2">
      <.link
        :if={:manage_privacy in @platform_access.capabilities}
        id="platform-capability-manage-privacy"
        navigate={~p"/platform/privacy/requests"}
        class="group rounded-xl border border-clubeira-line bg-white p-5 transition hover:border-blue-200"
      >
        <span class="clubeira-icon-tile">
          <.icon name="hero-shield-check" class="size-5" />
        </span>
        <h2 class="mt-5 text-sm font-bold text-slate-900">{gettext("Privacy operations")}</h2>
        <p class="mt-1.5 text-xs leading-5 text-slate-500">
          {gettext("Data-subject requests, processing purposes and immutable evidence.")}
        </p>
        <.icon
          name="hero-arrow-right"
          class="mt-5 size-4 text-clubeira-muted transition group-hover:translate-x-0.5 group-hover:text-clubeira-blue"
        />
      </.link>

      <.link
        :if={:manage_platform_billing in @platform_access.capabilities}
        id="platform-capability-manage-platform-billing"
        navigate={~p"/platform/billing/plans"}
        class="group rounded-xl border border-clubeira-line bg-white p-5 transition hover:border-orange-200"
      >
        <span class="grid size-10 place-items-center rounded-lg bg-clubeira-orange-soft text-clubeira-orange">
          <.icon name="hero-banknotes" class="size-5" />
        </span>
        <h2 class="mt-5 text-sm font-bold text-slate-900">{gettext("Platform billing")}</h2>
        <p class="mt-1.5 text-xs leading-5 text-slate-500">
          {gettext("Global plans, prices and SaaS subscription control.")}
        </p>
        <.icon
          name="hero-arrow-right"
          class="mt-5 size-4 text-clubeira-muted transition group-hover:translate-x-0.5 group-hover:text-clubeira-orange"
        />
      </.link>
    </section>
  </div>
</PlatformComponents.shell>
