<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:catalog}
>
  <div id="member-place-reviews" class="mx-auto max-w-5xl">
    <.link
      id="member-place-reviews-back"
      navigate={~p"/app/catalog?#{[polo: @polo.slug]}"}
      class="inline-flex items-center gap-2 text-sm font-bold text-blue-700 hover:text-blue-900"
    >
      <.icon name="hero-arrow-left" class="size-4" /> {gettext("Back to the catalog")}
    </.link>

    <section class="clubeira-ticket-rail clubeira-grid-paper mt-5 rounded-xl border border-clubeira-line bg-white px-6 py-7 sm:px-8">
      <p class="clubeira-page-kicker">
        {@polo.name}
      </p>
      <h1 class="clubeira-page-title mt-1.5">{@place.name}</h1>
      <p class="clubeira-page-copy mt-2">
        {gettext("Read verified experiences and help keep the community trustworthy.")}
      </p>
    </section>

    <section class="mt-8">
      <div id="member-place-review-list" phx-update="stream" class="grid gap-4 lg:grid-cols-2">
        <div
          id="member-place-reviews-empty"
          class="hidden only:block rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 lg:col-span-2"
        >
          {gettext("This place has no published reviews yet.")}
        </div>
        <article
          :for={{id, review} <- @streams.reviews}
          id={id}
          data-rating={review.rating}
          class="rounded-xl border border-clubeira-line bg-white p-6"
        >
          <div class="flex items-center justify-between gap-4">
            <span
              class="text-lg tracking-wider text-orange-500"
              aria-label={gettext("%{rating} out of 5", rating: review.rating)}
            >
              {String.duplicate("★", review.rating)}
            </span>
            <time
              class="text-xs font-bold text-slate-400"
              datetime={DateTime.to_iso8601(review.published_at)}
            >
              {Calendar.strftime(review.published_at, "%d/%m/%Y")}
            </time>
          </div>
          <h2 :if={review.title} class="mt-4 text-lg font-bold">{review.title}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{review.body}</p>
          <div
            :if={review.response}
            class="mt-5 rounded-lg border-l-2 border-clubeira-blue bg-clubeira-blue-soft p-4"
          >
            <p class="text-xs font-bold uppercase tracking-wider text-blue-700">
              {gettext("Response from %{organization}",
                organization: review.response.organization.name
              )}
            </p>
            <p class="mt-2 text-sm leading-6 text-blue-950">{review.response.body}</p>
          </div>
          <span
            :if={reported?(@reported_review_keys, review.public_key)}
            id={"review-report-submitted-#{review.public_key}"}
            class="mt-5 inline-flex items-center gap-2 rounded-xl bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-700"
          >
            <.icon name="hero-check-circle" class="size-4" /> {gettext("Report submitted")}
          </span>
          <button
            :if={!reported?(@reported_review_keys, review.public_key)}
            id={"report-review-#{review.public_key}"}
            type="button"
            phx-click="report_review"
            phx-value-review-key={review.public_key}
            class="mt-5 inline-flex h-10 items-center gap-2 rounded-xl border border-clubeira-line bg-white px-4 text-xs font-bold text-slate-600 hover:border-orange-200 hover:text-orange-700"
          >
            <.icon name="hero-flag" class="size-4" /> {gettext("Report review")}
          </button>
        </article>
      </div>

      <.link
        :if={@next_page_path}
        id="member-place-reviews-next-page"
        patch={@next_page_path}
        class="mt-6 inline-flex h-11 items-center gap-2 rounded-xl border border-clubeira-line bg-white px-5 text-sm font-bold text-slate-700"
      >
        {gettext("More reviews")} <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </section>

    <section
      :if={@report_form && @report_target}
      id="member-review-report-panel"
      class="mt-8 rounded-xl border border-orange-200 bg-white p-6 sm:p-8"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-600">
            {gettext("Community safety")}
          </p>
          <h2 class="mt-2 text-xl font-bold">{gettext("Report this review")}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            {gettext("Your reason goes only to the moderation team.")}
          </p>
        </div>
        <button
          id="cancel-member-review-report"
          type="button"
          phx-click="cancel_report"
          class="grid size-9 place-items-center rounded-xl bg-slate-100 text-slate-500"
          aria-label={gettext("Close report form")}
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>

      <.form
        for={@report_form}
        id="member-review-report-form"
        phx-change="validate_report"
        phx-submit="submit_report"
        class="mt-6 grid gap-4"
      >
        <.input
          field={@report_form[:reason_code]}
          type="select"
          label={gettext("Reason")}
          prompt={gettext("Choose a reason")}
          options={[
            {gettext("Spam"), "spam"},
            {gettext("Offensive content"), "offensive_content"},
            {gettext("Personal data"), "personal_data"},
            {gettext("Fraud"), "fraud"},
            {gettext("Other"), "other"}
          ]}
        />
        <.input
          field={@report_form[:details]}
          type="textarea"
          label={gettext("Details (optional)")}
        />
        <button
          id="submit-member-review-report"
          type="submit"
          class="inline-flex h-11 items-center justify-center rounded-xl bg-orange-500 px-5 text-sm font-bold text-white hover:bg-orange-600 sm:justify-self-start"
        >
          {gettext("Send report")}
        </button>
      </.form>
    </section>
  </div>
</MemberComponents.shell>
