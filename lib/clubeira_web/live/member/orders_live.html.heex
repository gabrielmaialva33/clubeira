<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:orders}
>
  <div id="member-orders" class="mx-auto max-w-5xl">
    <section class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="clubeira-page-kicker">
          {gettext("Purchase history")}
        </p><h1 class="clubeira-page-title mt-1.5">
          {gettext("My orders")}
        </h1><p class="mt-2 text-sm text-slate-500">
          {gettext("Resume pending payments without creating duplicate orders.")}
        </p>
      </div>
      <.form
        for={@polo_form}
        id="orders-polo-switcher"
        phx-change="change_orders_polo"
        class="w-full sm:w-72"
      >
        <.input
          field={@polo_form[:polo]}
          id="orders-polo"
          type="select"
          label={gettext("Polo")}
          options={Enum.map(@polos, &{&1.name, &1.slug})}
        />
      </.form>
    </section>

    <section
      :if={@payment_result}
      id="order-payment-result"
      class="mt-7 rounded-xl border border-blue-200 bg-white p-5 sm:p-6"
    >
      <div class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-xl bg-clubeira-orange text-white"><.icon
          name="hero-qr-code"
          class="size-5"
        /></span><div>
          <p class="text-sm font-bold">
            {gettext("Pix for order %{number}", number: @payment_result.order.order_number)}
          </p><p class="mt-0.5 text-xs text-slate-500">
            {money(@payment_result.amount, @payment_result.currency, @locale)}
          </p>
        </div>
      </div>
      <code
        id="order-payment-pix-code"
        class="mt-4 block break-all rounded-xl bg-slate-950 p-4 text-xs leading-5 text-slate-100"
      >{@payment_result.copy_paste_code}</code>
      <a
        :if={@payment_result.redirect_url}
        href={@payment_result.redirect_url}
        rel="noopener noreferrer"
        target="_blank"
        class="mt-4 inline-flex h-10 items-center gap-2 rounded-xl bg-orange-500 px-4 text-xs font-bold text-white"
      >{gettext("Open payment")} <.icon name="hero-arrow-top-right-on-square" class="size-4" /></a>
    </section>

    <div id="member-orders-list" phx-update="stream" class="mt-7 grid gap-4">
      <div
        id="member-orders-empty"
        class="hidden only:block rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500"
      >
        {gettext("No order found in this polo.")}
      </div>
      <article
        :for={{id, order} <- @streams.orders}
        id={id}
        class="rounded-xl border border-clubeira-line bg-white p-5 sm:p-6"
      >
        <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
          <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-orange-50 text-orange-600"><.icon
            name="hero-shopping-bag"
            class="size-5"
          /></span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <h2 class="text-sm font-bold">{order.order_number}</h2><span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700">{status_label(
                order.status
              )}</span>
            </div><p class="mt-1 text-xs text-slate-400">{timestamp(order.placed_at, @locale)}</p><div class="mt-4 space-y-1">
              <p :for={item <- order.items} class="text-sm font-semibold text-slate-700">
                {item.quantity}× {item.name}
              </p>
            </div>
          </div>
          <div class="sm:text-right">
            <p class="text-lg font-bold">{money(order.total_amount, order.currency, @locale)}</p><button
              :if={
                order.status in ["pending", "awaiting_payment"] and
                  web_payment_available?(order)
              }
              id={"pay-order-#{order.id}"}
              type="button"
              phx-click="pay_order"
              phx-value-order-id={order.id}
              class="clubeira-button-primary mt-3 h-10 px-4 text-xs"
            >{gettext("Pay now")} <.icon name="hero-arrow-right" class="size-4" /></button>
          </div>
        </div>
      </article>
    </div>
    <.link
      :if={@next_page_path}
      id="member-orders-next-page"
      patch={@next_page_path}
      class="mt-6 inline-flex h-11 items-center gap-2 rounded-xl border border-clubeira-line bg-white px-5 text-sm font-bold text-slate-700"
    >{gettext("Next page")} <.icon name="hero-arrow-right" class="size-4" /></.link>
  </div>
</MemberComponents.shell>
