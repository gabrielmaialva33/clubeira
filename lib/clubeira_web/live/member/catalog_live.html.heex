<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:catalog}
>
  <div id="member-catalog">
    <section class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
          {gettext("Discover nearby")}
        </p>
        <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] sm:text-4xl">
          {gettext("Explore Clubeira")}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          {gettext(
            "Choose your polo, discover its partner network and subscribe through the real checkout."
          )}
        </p>
      </div>
      <.form
        for={@polo_form}
        id="catalog-polo-switcher"
        phx-change="change_catalog_polo"
        class="relative w-full md:w-72"
      >
        <.input
          field={@polo_form[:polo]}
          id="catalog-polo"
          type="select"
          label={gettext("Polo")}
          options={Enum.map(@polos, &{&1.name, &1.slug})}
        />
      </.form>
    </section>

    <section
      :if={@checkout_result}
      id="checkout-result"
      class="mt-7 overflow-hidden rounded-2xl border border-blue-200 bg-white shadow-[0_14px_45px_rgba(37,99,235,.10)]"
    >
      <div class="flex items-center gap-3 bg-blue-50 px-5 py-4 text-blue-900 sm:px-6">
        <span class="grid size-10 place-items-center rounded-xl bg-blue-600 text-white"><.icon
          name="hero-check"
          class="size-5"
        /></span>
        <div>
          <p class="text-sm font-black">
            {gettext("Order %{number}", number: @checkout_result.order.order_number)}
          </p>
          <p class="mt-0.5 text-xs text-blue-700">
            {gettext("Your order is safely recorded and can be resumed later.")}
          </p>
        </div>
      </div>
      <div
        :if={@checkout_result.kind == :pix}
        class="grid gap-5 p-5 sm:grid-cols-[1fr_auto] sm:p-6"
      >
        <div>
          <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
            {gettext("Pix copy and paste")}
          </p>
          <code
            id="checkout-pix-copy-paste"
            class="mt-2 block break-all rounded-xl bg-slate-950 p-4 text-xs leading-5 text-slate-100"
          >{@checkout_result.copy_paste_code}</code>
          <p class="mt-3 text-sm font-black">
            {money(@checkout_result.amount, @checkout_result.currency, @locale)}
          </p>
        </div>
        <a
          :if={@checkout_result.redirect_url}
          id="checkout-pix-provider-link"
          href={@checkout_result.redirect_url}
          rel="noopener noreferrer"
          target="_blank"
          class="inline-flex h-11 items-center justify-center gap-2 self-end rounded-xl bg-orange-500 px-5 text-sm font-black text-white hover:bg-orange-600"
        >
          {gettext("Open payment")} <.icon name="hero-arrow-top-right-on-square" class="size-4" />
        </a>
      </div>
      <div :if={@checkout_result.kind == :pending} class="p-5 sm:p-6">
        <.link
          navigate={~p"/app/orders?#{[polo: @current_polo.slug]}"}
          class="inline-flex h-11 items-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-black text-white hover:bg-blue-700"
        >{gettext("Open my orders")} <.icon name="hero-arrow-right" class="size-4" /></.link>
      </div>
    </section>

    <section class="mt-8">
      <div class="flex items-end justify-between gap-4">
        <div>
          <h2 class="text-xl font-black tracking-[-0.03em]">
            {gettext("Available subscriptions")}
          </h2>
          <p class="mt-1 text-sm text-slate-500">
            {gettext("Price and eligibility are revalidated when you confirm.")}
          </p>
        </div>
      </div>
      <div id="checkout-options" phx-update="stream" class="mt-4 grid gap-4 lg:grid-cols-3">
        <div
          id="checkout-options-empty"
          class="hidden only:block rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 lg:col-span-3"
        >
          {gettext("No subscription is on sale in this polo right now.")}
        </div>
        <article
          :for={{id, option} <- @streams.checkout_options}
          id={id}
          class="flex flex-col rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)]"
        >
          <span class="w-fit rounded-full bg-orange-50 px-2.5 py-1 text-[10px] font-black uppercase tracking-wider text-orange-700">{gettext(
            "Subscription"
          )}</span>
          <h3 class="mt-4 text-lg font-black">{option.name}</h3>
          <p class="mt-2 flex-1 text-xs leading-5 text-slate-500">{option.description}</p>
          <div class="mt-5 border-t border-slate-100 pt-4">
            <p class="text-2xl font-black tracking-[-0.04em]">
              {money(option.amount, option.currency, @locale)}
            </p>
            <p class="mt-1 text-xs text-slate-400">
              {gettext("every %{count} %{unit}",
                count: option.billing_interval_count,
                unit: option.billing_interval_unit
              )}
            </p>
          </div>
          <button
            type="button"
            phx-click="checkout"
            phx-value-price-id={option.offering_price_id}
            class="mt-5 inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 text-sm font-black text-white shadow-[0_10px_24px_rgba(37,99,235,.20)] hover:bg-blue-700"
          >
            {gettext("Subscribe now")} <.icon name="hero-arrow-right" class="size-4" />
          </button>
        </article>
      </div>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-black tracking-[-0.03em]">
        {gettext("Benefits in %{polo}", polo: @current_polo.name)}
      </h2>
      <div
        id="catalog-offers"
        phx-update="stream"
        class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"
      >
        <div
          id="catalog-offers-empty"
          class="hidden only:block rounded-2xl border border-dashed border-slate-300 bg-white p-8 text-center text-sm text-slate-500 sm:col-span-2 xl:col-span-3"
        >
          {gettext("No published benefit is available right now.")}
        </div>
        <article
          :for={{id, offer} <- @streams.offers}
          id={id}
          class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]"
        >
          <div class="h-2 bg-gradient-to-r from-blue-600 via-blue-500 to-orange-500" />
          <div class="p-5">
            <div class="flex items-start justify-between gap-3">
              <div>
                <p class="text-[10px] font-black uppercase tracking-wider text-blue-600">
                  {benefit_value(offer)}
                </p><h3 class="mt-2 text-base font-black">{offer.title}</h3>
              </div>
              <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-orange-50 text-orange-600"><.icon
                name="hero-gift"
                class="size-5"
              /></span>
            </div>
            <p class="mt-3 text-xs leading-5 text-slate-500">{offer.description}</p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <.link
                :for={place <- offer.places}
                id={"catalog-place-reviews-#{offer.offer_version_id}-#{place.slug}"}
                navigate={~p"/app/catalog/#{@current_polo.slug}/places/#{place.slug}/reviews"}
                class="rounded-lg bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600"
              >{place.name}</.link>
            </div>
          </div>
        </article>
      </div>
      <.link
        :if={@next_page_path}
        id="catalog-next-page"
        patch={@next_page_path}
        class="mt-6 inline-flex h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 text-sm font-bold text-slate-700 shadow-sm"
      >{gettext("More benefits")} <.icon name="hero-arrow-right" class="size-4" /></.link>
    </section>
  </div>
</MemberComponents.shell>
