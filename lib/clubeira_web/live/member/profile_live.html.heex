<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:profile}
>
  <div id="member-profile" class="mx-auto max-w-4xl">
    <section>
      <p class="clubeira-page-kicker">
        {gettext("Protected identity")}
      </p><h1 class="clubeira-page-title mt-1.5">
        {gettext("My profile")}
      </h1><p class="clubeira-page-copy mt-1.5">
        {gettext(
          "Sensitive values are encrypted and never returned by the server. Leave CPF or phone blank to keep the current value."
        )}
      </p>
    </section>

    <section id="member-profile-state" class="mt-7 grid gap-3 sm:grid-cols-2">
      <div
        id="profile-cpf-present"
        class={[
          "rounded-xl border p-4",
          credential_present?(@profile, "cpf") && "border-emerald-200 bg-emerald-50",
          !credential_present?(@profile, "cpf") && "border-clubeira-line bg-white"
        ]}
      >
        <div class="flex items-center gap-3">
          <.icon name="hero-identification" class="size-5 text-blue-600" /><div>
            <p class="text-xs font-bold">CPF</p><p class="mt-0.5 text-[11px] text-slate-500">
              {if credential_present?(@profile, "cpf"),
                do: gettext("Protected value registered"),
                else: gettext("Not registered")}
            </p>
          </div>
        </div>
      </div>
      <div
        id="profile-phone-present"
        class={[
          "rounded-xl border p-4",
          contact_present?(@profile, "phone") && "border-emerald-200 bg-emerald-50",
          !contact_present?(@profile, "phone") && "border-clubeira-line bg-white"
        ]}
      >
        <div class="flex items-center gap-3">
          <.icon name="hero-device-phone-mobile" class="size-5 text-orange-600" /><div>
            <p class="text-xs font-bold">{gettext("Phone")}</p><p class="mt-0.5 text-[11px] text-slate-500">
              {if contact_present?(@profile, "phone"),
                do: gettext("Protected value registered"),
                else: gettext("Not registered")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="mt-5 rounded-xl border border-clubeira-line bg-white p-5 sm:p-7">
      <.form
        for={@profile_form}
        id="member-profile-form"
        phx-change="validate_profile"
        phx-submit="save_profile"
        class="grid gap-5 sm:grid-cols-2"
      >
        <div class="sm:col-span-2">
          <.input
            field={@profile_form[:display_name]}
            type="text"
            label={gettext("Display name")}
            autocomplete="name"
          />
        </div>
        <.input field={@profile_form[:birth_date]} type="date" label={gettext("Birth date")} />
        <div class="hidden sm:block" />
        <.input
          field={@profile_form[:cpf]}
          type="text"
          label="CPF"
          autocomplete="off"
          placeholder={gettext("Leave blank to keep it")}
        />
        <.input
          field={@profile_form[:phone]}
          type="tel"
          label={gettext("Phone")}
          autocomplete="tel"
          placeholder={gettext("Leave blank to keep it")}
        />
        <div class="sm:col-span-2">
          <button
            id="member-profile-submit"
            type="submit"
            class="clubeira-button-primary"
          >{gettext("Save profile")} <.icon name="hero-check" class="size-4" /></button>
        </div>
      </.form>
    </section>
  </div>
</MemberComponents.shell>
