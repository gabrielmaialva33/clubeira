<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:wallet}
>
  <div id="member-wallet" class="mx-auto max-w-6xl">
    <div id="member-device-installation" phx-hook=".RedemptionInstallation"></div>
    <script :type={Phoenix.LiveView.ColocatedHook} name=".RedemptionInstallation">
      const storageKey = "clubeira.redemption.installation.v1"

      export default {
        mounted() {
          this.handleEvent("request_installation_token", () => {
            this.pushEvent("issue_redemption_grant", {
              installation_token: this.installationToken()
            })
          })
        },

        installationToken() {
          const current = window.localStorage.getItem(storageKey)
          if (current) return current

          const bytes = window.crypto.getRandomValues(new Uint8Array(32))
          const binary = String.fromCharCode(...bytes)
          const token = window.btoa(binary)
            .replace(/\+/g, "-")
            .replace(/\//g, "_")
            .replace(/=+$/g, "")

          window.localStorage.setItem(storageKey, token)
          return token
        }
      }
    </script>
    <section class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
          {gettext("Available benefits")}
        </p>
        <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] sm:text-4xl">
          {gettext("My wallet")}
        </h1>
        <p class="mt-2 text-sm text-slate-500">
          {gettext("Your current vouchers and verified redemption history.")}
        </p>
      </div>
      <.form
        for={@polo_form}
        id="wallet-polo-switcher"
        phx-change="change_wallet_polo"
        class="w-full sm:w-72"
      >
        <.input
          field={@polo_form[:polo]}
          id="wallet-polo"
          type="select"
          label={gettext("Polo")}
          options={Enum.map(@polos, &{&1.name, &1.slug})}
        />
      </.form>
    </section>

    <section class="mt-8">
      <div class="flex items-end justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-600">
            {gettext("Ready to use")}
          </p>
          <h2 class="mt-1 text-xl font-black">{gettext("Vouchers")}</h2>
        </div>
        <span class="text-xs font-bold text-slate-400">{@current_polo.name}</span>
      </div>

      <div id="member-vouchers-list" phx-update="stream" class="mt-4 grid gap-4 lg:grid-cols-2">
        <div
          id="member-vouchers-empty"
          class="hidden only:block rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 lg:col-span-2"
        >
          {gettext("No voucher is available in this polo right now.")}
        </div>
        <article
          :for={{id, voucher} <- @streams.vouchers}
          id={id}
          class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_10px_35px_rgba(15,23,42,.04)]"
        >
          <div class="h-1.5 bg-gradient-to-r from-blue-600 via-blue-500 to-orange-500"></div>
          <div class="p-5 sm:p-6">
            <div class="flex items-start gap-4">
              <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-700">
                <.icon name="hero-ticket" class="size-5" />
              </span>
              <div class="min-w-0 flex-1">
                <p
                  data-benefit-value
                  class="text-[10px] font-black uppercase tracking-[0.16em] text-blue-600"
                >
                  {benefit_value(voucher.offer, @locale)}
                </p>
                <h3 class="mt-1 text-base font-black">{voucher.offer.title}</h3>
                <p class="mt-2 text-sm leading-6 text-slate-500">{voucher.offer.description}</p>
              </div>
              <div class="rounded-xl bg-orange-50 px-3 py-2 text-center">
                <p class="text-lg font-black text-orange-700">{voucher.available_units}</p>
                <p class="text-[9px] font-bold uppercase tracking-wider text-orange-600">
                  {gettext("left")}
                </p>
              </div>
            </div>
            <div class="mt-5 rounded-xl bg-slate-50 p-4">
              <p class="text-xs font-bold text-slate-700">{gettext("Where to use")}</p>
              <div class="mt-2 flex flex-wrap gap-2">
                <span
                  :for={place <- voucher.places}
                  class="rounded-full bg-white px-3 py-1.5 text-[11px] font-bold text-slate-600 shadow-sm"
                >
                  {place.name}
                </span>
                <span :if={voucher.places == []} class="text-xs text-slate-400">
                  {gettext("No active location is available.")}
                </span>
              </div>
            </div>
            <p class="mt-4 text-xs leading-5 text-slate-500">
              {voucher.offer.redemption_instructions}
            </p>
            <button
              :if={voucher.available_units > 0 && voucher.places != []}
              id={"redeem-voucher-#{voucher.allocation_id}"}
              type="button"
              phx-click="prepare_redemption"
              phx-value-allocation-id={voucher.allocation_id}
              class="mt-4 inline-flex h-10 w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 text-xs font-black text-white hover:bg-blue-700"
            >
              <.icon name="hero-qr-code" class="size-4" /> {gettext("Use benefit now")}
            </button>
          </div>
        </article>
      </div>
    </section>

    <section
      :if={@redemption_grant}
      id="member-redemption-grant"
      class="mt-8 rounded-2xl border border-orange-200 bg-white p-5 shadow-[0_18px_55px_rgba(249,115,22,.12)] sm:p-7"
    >
      <div class="flex items-start gap-4">
        <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-orange-500 text-white">
          <.icon name="hero-qr-code" class="size-6" />
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-600">
            {gettext("Short-lived redemption code")}
          </p>
          <h2 class="mt-1 text-lg font-black">{@redemption_grant.voucher.offer.title}</h2>
          <p class="mt-2 text-sm leading-6 text-slate-500">
            {gettext("Present this code at the validation point. It expires at %{time}.",
              time: timestamp(@redemption_grant.grant.expires_at, @locale)
            )}
          </p>
        </div>
      </div>
      <code
        id="member-redemption-grant-token"
        class="mt-5 block break-all rounded-xl bg-slate-950 p-4 text-xs leading-5 text-slate-100"
      >{@redemption_grant.grant.token}</code>
      <p class="mt-3 text-xs text-slate-400">
        {gettext("Keep this screen private. The code authorizes one redemption only.")}
      </p>
    </section>

    <section class="mt-10 border-t border-slate-200 pt-8">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-600">
        {gettext("Recent activity")}
      </p>
      <h2 class="mt-1 text-xl font-black">{gettext("Redemptions")}</h2>

      <div id="member-redemptions-list" phx-update="stream" class="mt-4 grid gap-3">
        <div
          id="member-redemptions-empty"
          class="hidden only:block rounded-2xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500"
        >
          {gettext("No redemption recorded in this polo yet.")}
        </div>
        <article
          :for={{id, redemption} <- @streams.redemptions}
          id={id}
          class="flex flex-col gap-4 rounded-2xl border border-slate-200 bg-white p-5 sm:flex-row sm:items-center"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-emerald-50 text-emerald-700">
            <.icon name="hero-check-badge" class="size-5" />
          </span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-black">{redemption.benefit.title}</p>
            <p class="mt-1 text-xs text-slate-500">
              {redemption.place.name} · {timestamp(redemption.redeemed_at, @locale)}
            </p>
          </div>
          <span
            :if={redemption.review}
            data-review-status={redemption.review.status}
            class="rounded-full bg-blue-50 px-3 py-1.5 text-[10px] font-black uppercase tracking-wider text-blue-700"
          >
            {gettext("Review %{status}", status: redemption.review.status)}
          </span>
          <button
            :if={is_nil(redemption.review)}
            id={"review-redemption-#{redemption.id}"}
            type="button"
            phx-click="review_redemption"
            phx-value-redemption-id={redemption.id}
            class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-orange-500 px-4 text-xs font-black text-white hover:bg-orange-600"
          >
            <.icon name="hero-star" class="size-4" /> {gettext("Write review")}
          </button>
        </article>
      </div>

      <.link
        :if={@next_page_path}
        id="member-redemptions-next-page"
        patch={@next_page_path}
        class="mt-5 inline-flex h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 text-sm font-bold text-slate-700"
      >
        {gettext("Next page")} <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </section>

    <section
      :if={@review_form && @review_target}
      id="member-review-panel"
      class="mt-8 rounded-2xl border border-blue-200 bg-white p-5 shadow-[0_18px_55px_rgba(37,99,235,.10)] sm:p-7"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-600">
            {gettext("Verified visit")}
          </p>
          <h2 class="mt-1 text-xl font-black">{@review_target.place.name}</h2>
          <p class="mt-1 text-sm text-slate-500">{@review_target.benefit.title}</p>
        </div>
        <button
          id="cancel-member-review"
          type="button"
          phx-click="cancel_review"
          class="grid size-9 place-items-center rounded-xl bg-slate-100 text-slate-500"
          aria-label={gettext("Close review form")}
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>

      <.form
        for={@review_form}
        id="member-review-form"
        phx-change="validate_review"
        phx-submit="submit_review"
        class="mt-6 grid gap-4"
      >
        <.input
          field={@review_form[:rating]}
          type="select"
          label={gettext("Rating")}
          options={Enum.map(5..1//-1, &{gettext("%{rating} stars", rating: &1), &1})}
        />
        <.input field={@review_form[:title]} type="text" label={gettext("Title (optional)")} />
        <.input field={@review_form[:body]} type="textarea" label={gettext("Your review")} />
        <button
          id="submit-member-review"
          type="submit"
          class="inline-flex h-11 items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-black text-white hover:bg-blue-700 sm:justify-self-start"
        >
          {gettext("Submit review")}
        </button>
      </.form>
    </section>
  </div>
</MemberComponents.shell>
