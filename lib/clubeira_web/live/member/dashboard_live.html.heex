<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:overview}
>
  <div id="member-dashboard">
    <section class="relative overflow-hidden rounded-[28px] bg-[#0b2342] px-6 py-8 text-white shadow-[0_24px_70px_rgba(8,27,51,.18)] sm:px-10 sm:py-11">
      <div class="absolute inset-y-0 right-0 w-3/5 bg-[radial-gradient(circle_at_center,rgba(37,99,235,.48),transparent_65%)]" />
      <div class="absolute -right-16 -top-20 size-64 rounded-full border-[40px] border-orange-500/20" />
      <div class="relative max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-300">
          {gettext("Your club, always with you")}
        </p>
        <h1 class="mt-3 text-3xl font-black tracking-[-0.045em] sm:text-5xl">
          {gettext("Benefits that fit your city and your routine.")}
        </h1>
        <p class="mt-4 max-w-xl text-sm leading-6 text-slate-300 sm:text-base">
          {gettext(
            "Explore partner places, follow your subscriptions and use every available voucher with confidence."
          )}
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <.link
            id="member-dashboard-explore"
            navigate={~p"/app/catalog"}
            class="inline-flex h-11 items-center gap-2 rounded-xl bg-orange-500 px-5 text-sm font-black text-white shadow-lg transition hover:bg-orange-600"
          >
            {gettext("Explore benefits")} <.icon name="hero-arrow-right" class="size-4" />
          </.link>
          <.link
            id="member-dashboard-wallet"
            navigate={~p"/app/wallet"}
            class="inline-flex h-11 items-center gap-2 rounded-xl border border-white/15 bg-white/10 px-5 text-sm font-bold text-white backdrop-blur transition hover:bg-white/15"
          >
            <.icon name="hero-ticket" class="size-4" /> {gettext("Open wallet")}
          </.link>
        </div>
      </div>
    </section>

    <section class="mt-7 grid gap-4 sm:grid-cols-3">
      <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <span class="grid size-10 place-items-center rounded-xl bg-blue-50 text-blue-600"><.icon
          name="hero-credit-card"
          class="size-5"
        /></span>
        <p id="member-dashboard-subscription-count" class="mt-5 text-2xl font-black">
          {@subscription_count}
        </p>
        <p class="mt-1 text-xs font-semibold text-slate-500">{gettext("Recent subscriptions")}</p>
      </article>
      <.link
        navigate={~p"/app/profile"}
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] transition hover:border-blue-200"
      >
        <span class="grid size-10 place-items-center rounded-xl bg-orange-50 text-orange-600"><.icon
          name="hero-user"
          class="size-5"
        /></span>
        <p class="mt-5 text-sm font-black">{gettext("Keep your profile current")}</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">
          {gettext("Identity and contact data stay protected.")}
        </p>
      </.link>
      <.link
        navigate={~p"/app/privacy"}
        class="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] transition hover:border-blue-200"
      >
        <span class="grid size-10 place-items-center rounded-xl bg-emerald-50 text-emerald-600"><.icon
          name="hero-shield-check"
          class="size-5"
        /></span>
        <p class="mt-5 text-sm font-black">{gettext("Privacy under your control")}</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">
          {gettext("Consents and requests in one place.")}
        </p>
      </.link>
    </section>

    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6">
        <div>
          <h2 class="text-sm font-black">{gettext("Your recent subscriptions")}</h2>
          <p class="mt-1 text-xs text-slate-500">
            {gettext("Each polo remains independently protected.")}
          </p>
        </div>
        <.link
          navigate={~p"/app/subscriptions"}
          class="text-xs font-bold text-blue-700 hover:text-blue-900"
        >{gettext("View all")}</.link>
      </div>
      <div
        id="member-dashboard-subscriptions"
        phx-update="stream"
        class="divide-y divide-slate-100"
      >
        <div
          id="member-dashboard-subscriptions-empty"
          class="hidden only:flex px-6 py-9 text-sm text-slate-500"
        >
          {gettext("You do not have a subscription yet. Explore the catalog to get started.")}
        </div>
        <div
          :for={{id, subscription} <- @streams.subscriptions}
          id={id}
          class="flex items-center gap-4 px-5 py-4 sm:px-6"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-600"><.icon
            name="hero-ticket"
            class="size-5"
          /></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-bold">{subscription.offering.name}</p>
            <p class="mt-0.5 truncate text-xs text-slate-500">{subscription.polo.name}</p>
          </div>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700">{status_label(
            subscription.status
          )}</span>
        </div>
      </div>
    </section>
  </div>
</MemberComponents.shell>
