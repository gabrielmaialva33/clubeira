<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:overview}
>
  <div id="member-dashboard">
    <section class="clubeira-ticket-rail clubeira-grid-paper overflow-hidden rounded-xl border border-clubeira-line bg-white">
      <div class="grid lg:grid-cols-[minmax(0,1.35fr)_minmax(300px,0.65fr)]">
        <div class="px-6 py-8 sm:px-9 sm:py-10">
          <p class="clubeira-page-kicker">
            {gettext("Your club, always with you")}
          </p>
          <h1 class="mt-3 max-w-2xl text-3xl font-bold tracking-[-0.045em] text-clubeira-ink sm:text-4xl">
            {gettext("Benefits that fit your city and your routine.")}
          </h1>
          <p class="mt-4 max-w-xl text-sm leading-6 text-clubeira-muted sm:text-base">
            {gettext(
              "Explore partner places, follow your subscriptions and use every available voucher with confidence."
            )}
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <.link
              id="member-dashboard-explore"
              navigate={~p"/app/catalog"}
              class="clubeira-button-primary"
            >
              {gettext("Explore benefits")} <.icon name="hero-arrow-right" class="size-4" />
            </.link>
            <.link
              id="member-dashboard-wallet"
              navigate={~p"/app/wallet"}
              class="clubeira-button-secondary"
            >
              <.icon name="hero-ticket" class="size-4 text-clubeira-blue" /> {gettext(
                "Open wallet"
              )}
            </.link>
          </div>
        </div>

        <.link
          navigate={~p"/app/wallet"}
          class="group flex min-h-56 items-center justify-center border-t border-clubeira-line bg-clubeira-blue-soft/65 p-8 lg:border-l lg:border-t-0"
        >
          <div class="text-center">
            <span class="mx-auto grid size-16 place-items-center rounded-xl bg-white text-clubeira-blue ring-1 ring-clubeira-line transition group-hover:border-blue-200 group-hover:text-clubeira-orange">
              <.icon name="hero-ticket" class="size-8" />
            </span>
            <p class="mt-5 text-sm font-bold text-clubeira-ink">{gettext("Open wallet")}</p>
            <p class="mt-1 text-xs text-clubeira-muted">
              {@subscription_count} · {gettext("Recent subscriptions")}
            </p>
          </div>
        </.link>
      </div>
    </section>

    <section class="mt-7 grid gap-4 sm:grid-cols-3">
      <article class="rounded-xl border border-clubeira-line bg-white p-4">
        <span class="clubeira-icon-tile"><.icon
          name="hero-credit-card"
          class="size-5"
        /></span>
        <p id="member-dashboard-subscription-count" class="mt-4 text-2xl font-bold">
          {@subscription_count}
        </p>
        <p class="mt-1 text-xs font-semibold text-slate-500">{gettext("Recent subscriptions")}</p>
      </article>
      <.link
        navigate={~p"/app/profile"}
        class="rounded-xl border border-clubeira-line bg-white p-4 transition hover:border-blue-200"
      >
        <span class="grid size-10 place-items-center rounded-xl bg-orange-50 text-orange-600"><.icon
          name="hero-user"
          class="size-5"
        /></span>
        <p class="mt-4 text-sm font-bold">{gettext("Keep your profile current")}</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">
          {gettext("Identity and contact data stay protected.")}
        </p>
      </.link>
      <.link
        navigate={~p"/app/privacy"}
        class="rounded-xl border border-clubeira-line bg-white p-4 transition hover:border-blue-200"
      >
        <span class="grid size-10 place-items-center rounded-xl bg-emerald-50 text-emerald-600"><.icon
          name="hero-shield-check"
          class="size-5"
        /></span>
        <p class="mt-4 text-sm font-bold">{gettext("Privacy under your control")}</p>
        <p class="mt-1 text-xs leading-5 text-slate-500">
          {gettext("Consents and requests in one place.")}
        </p>
      </.link>
    </section>

    <section class="mt-7 overflow-hidden rounded-xl border border-clubeira-line bg-white">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6">
        <div>
          <h2 class="text-sm font-bold">{gettext("Your recent subscriptions")}</h2>
          <p class="mt-1 text-xs text-slate-500">
            {gettext("Each polo remains independently protected.")}
          </p>
        </div>
        <.link
          navigate={~p"/app/subscriptions"}
          class="text-xs font-bold text-blue-700 hover:text-blue-900"
        >{gettext("View all")}</.link>
      </div>
      <div
        id="member-dashboard-subscriptions"
        phx-update="stream"
        class="divide-y divide-slate-100"
      >
        <div
          id="member-dashboard-subscriptions-empty"
          class="hidden only:flex px-6 py-9 text-sm text-slate-500"
        >
          {gettext("You do not have a subscription yet. Explore the catalog to get started.")}
        </div>
        <div
          :for={{id, subscription} <- @streams.subscriptions}
          id={id}
          class="flex items-center gap-4 px-5 py-4 sm:px-6"
        >
          <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-600"><.icon
            name="hero-ticket"
            class="size-5"
          /></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-bold">{subscription.offering.name}</p>
            <p class="mt-0.5 truncate text-xs text-slate-500">{subscription.polo.name}</p>
          </div>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold text-slate-700">{status_label(
            subscription.status
          )}</span>
        </div>
      </div>
    </section>
  </div>
</MemberComponents.shell>
