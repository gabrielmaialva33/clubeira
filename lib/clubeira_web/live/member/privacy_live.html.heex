<MemberComponents.shell
  account_scope={@current_account_scope}
  flash={@flash}
  active_section={:privacy}
>
  <div id="member-privacy" class="mx-auto max-w-5xl">
    <section>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
        {gettext("Your data, your choices")}
      </p>
      <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] sm:text-4xl">
        {gettext("Privacy")}
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
        {gettext("Manage your consent and follow requests about your personal data.")}
      </p>
    </section>

    <section
      id="member-privacy-consents-section"
      class="mt-7 rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:p-7"
    >
      <div class="flex items-start gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-700">
          <.icon name="hero-shield-check" class="size-5" />
        </span>
        <div>
          <h2 class="text-lg font-black tracking-tight">{gettext("Consent")}</h2>
          <p class="mt-1 text-sm text-slate-500">
            {gettext("Choose how each optional purpose may use your data.")}
          </p>
        </div>
      </div>

      <div id="member-privacy-consents" phx-update="stream" class="mt-5 grid gap-3">
        <div
          id="member-privacy-consents-empty"
          class="hidden only:block rounded-xl border border-dashed border-slate-200 p-5 text-sm text-slate-500"
        >
          {gettext("There are no consent choices available right now.")}
        </div>
        <article
          :for={{dom_id, consent} <- @streams.consents}
          id={dom_id}
          data-state={consent.state}
          class="rounded-2xl border border-slate-200 p-4 sm:flex sm:items-center sm:justify-between sm:gap-5"
        >
          <div>
            <h3 class="font-black text-slate-900">{consent.processing_purpose.name}</h3>
            <p class="mt-1 text-xs font-bold uppercase tracking-wide text-slate-500">
              {consent_state_label(consent.state)}
            </p>
          </div>
          <div class="mt-4 flex gap-2 sm:mt-0">
            <button
              id={"grant-consent-#{consent.processing_purpose.code}"}
              type="button"
              phx-click="put_consent"
              phx-value-purpose-code={consent.processing_purpose.code}
              phx-value-state="granted"
              disabled={consent.state == "granted"}
              class="rounded-xl bg-blue-600 px-4 py-2 text-xs font-black text-white disabled:cursor-not-allowed disabled:opacity-40"
            >
              {gettext("Allow")}
            </button>
            <button
              id={"withdraw-consent-#{consent.processing_purpose.code}"}
              type="button"
              phx-click="put_consent"
              phx-value-purpose-code={consent.processing_purpose.code}
              phx-value-state="withdrawn"
              disabled={consent.state == "withdrawn"}
              class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-black text-slate-700 disabled:cursor-not-allowed disabled:opacity-40"
            >
              {gettext("Withdraw")}
            </button>
          </div>
        </article>
      </div>
    </section>

    <section
      id="member-privacy-requests-section"
      class="mt-5 rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:p-7"
    >
      <div class="flex items-start gap-3">
        <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-orange-50 text-orange-700">
          <.icon name="hero-document-text" class="size-5" />
        </span>
        <div>
          <h2 class="text-lg font-black tracking-tight">{gettext("Data requests")}</h2>
          <p class="mt-1 text-sm text-slate-500">
            {gettext("Send a request and follow its processing timeline.")}
          </p>
        </div>
      </div>

      <.form
        for={@request_form}
        id="member-privacy-request-form"
        phx-change="validate_request"
        phx-submit="submit_request"
        class="mt-5 flex flex-col gap-3 rounded-2xl bg-slate-50 p-4 sm:flex-row sm:items-end"
      >
        <div class="min-w-0 flex-1">
          <.input
            field={@request_form[:request_type]}
            type="select"
            label={gettext("What do you need?")}
            options={
              Enum.map(
                ~w(access confirmation correction portability deletion anonymization consent_withdrawal information),
                &{request_type_label(&1), &1}
              )
            }
          />
        </div>
        <button
          id="member-privacy-request-submit"
          type="submit"
          phx-disable-with={gettext("Sending…")}
          class="inline-flex h-11 items-center justify-center gap-2 rounded-xl bg-orange-600 px-5 text-sm font-black text-white hover:bg-orange-700"
        >
          {gettext("Send request")}
          <.icon name="hero-arrow-right" class="size-4" />
        </button>
      </.form>

      <div id="member-privacy-requests" phx-update="stream" class="mt-5 grid gap-3">
        <div
          id="member-privacy-requests-empty"
          class="hidden only:block rounded-xl border border-dashed border-slate-200 p-5 text-sm text-slate-500"
        >
          {gettext("You have not sent any data requests yet.")}
        </div>
        <article
          :for={{dom_id, request} <- @streams.requests}
          id={dom_id}
          data-status={request.status}
          data-request-type={request.request_type}
          class="rounded-2xl border border-slate-200 p-4"
        >
          <div class="flex flex-wrap items-center justify-between gap-3">
            <div>
              <h3 class="font-black text-slate-900">
                {request_type_label(request.request_type)}
              </h3>
              <p class="mt-1 text-xs text-slate-500">
                {gettext("Sent %{at}", at: timestamp(request.inserted_at, @locale))}
              </p>
            </div>
            <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-black text-blue-700">
              {request_status_label(request.status)}
            </span>
          </div>
          <p class="mt-3 text-xs text-slate-500">
            {gettext("Legal deadline: %{at}", at: timestamp(request.due_at, @locale))}
          </p>
        </article>
      </div>
    </section>
  </div>
</MemberComponents.shell>
