<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:commercial}
>
  <div id="product-offerings-page" class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
          {gettext("Commercial catalog")}
        </p>
        <h1 class="clubeira-page-title mt-1.5">
          {gettext("Subscription offerings")}
        </h1>
        <p class="clubeira-page-copy mt-1.5">
          {gettext("Compose purchasable plans from immutable published benefits.")}
        </p>
      </div>
      <.link
        id="commercial-benefits-link"
        navigate={~p"/admin/commercial/benefits?#{[polo: @current_polo.slug]}"}
        class="inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-clubeira-line bg-white px-5 text-sm font-bold text-slate-700 transition hover:border-blue-200 hover:text-blue-700"
      >
        <.icon name="hero-arrow-left" class="size-4" />
        {gettext("Benefits")}
      </.link>
    </header>

    <section class="mt-7 rounded-xl border border-clubeira-line bg-white p-5 sm:p-6">
      <h2 class="text-lg font-bold text-slate-950">{gettext("Publish offering")}</h2>
      <p class="mt-1 text-sm leading-6 text-slate-500">
        {gettext("The plan, price and entitlement package are committed in one transaction.")}
      </p>

      <div
        :if={@benefit_options == []}
        id="offering-publication-without-benefits"
        class="mt-5 rounded-xl border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-800"
      >
        {gettext("Publish at least one active benefit before creating an offering.")}
      </div>

      <.form
        :if={@benefit_options != []}
        for={@publish_form}
        id="product-offering-publish-form"
        phx-change="validate_product_offering"
        phx-submit="publish_product_offering"
        class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"
      >
        <.input field={@publish_form[:idempotency_key]} type="hidden" />
        <.input field={@publish_form[:code]} type="text" label={gettext("Code")} />
        <.input field={@publish_form[:name]} type="text" label={gettext("Name")} />
        <.input
          field={@publish_form[:renewal_policy]}
          type="select"
          label={gettext("Renewal policy")}
          options={[
            {gettext("No renewal"), "none"},
            {gettext("Manual"), "manual"},
            {gettext("Automatic"), "automatic"}
          ]}
        />
        <div class="sm:col-span-2 lg:col-span-3">
          <.input
            field={@publish_form[:description]}
            type="textarea"
            label={gettext("Description")}
          />
        </div>
        <.input
          field={@publish_form[:cycle_policy]}
          type="select"
          label={gettext("Cycle policy")}
          options={[
            {gettext("Calendar"), "calendar"},
            {gettext("Anniversary"), "anniversary"}
          ]}
        />
        <.input
          field={@publish_form[:cycle_interval_unit]}
          type="select"
          label={gettext("Cycle unit")}
          options={[
            {gettext("Day"), "day"},
            {gettext("Month"), "month"},
            {gettext("Year"), "year"}
          ]}
        />
        <.input
          field={@publish_form[:cycle_interval_count]}
          type="number"
          label={gettext("Cycle count")}
          min="1"
        />
        <.input
          field={@publish_form[:effective_from]}
          type="datetime-local"
          label={gettext("Effective from")}
        />
        <.input
          field={@publish_form[:effective_until]}
          type="datetime-local"
          label={gettext("Effective until")}
        />
        <div class="hidden lg:block" />
        <.input
          field={@publish_form[:currency]}
          type="text"
          label={gettext("Currency")}
          maxlength="3"
        />
        <.input
          field={@publish_form[:amount]}
          type="number"
          label={gettext("Price")}
          min="0"
          step="0.01"
        />

        <fieldset class="sm:col-span-2 lg:col-span-3">
          <legend class="text-xs font-bold text-slate-700">{gettext("Included benefits")}</legend>
          <.inputs_for :let={benefit_form} field={@publish_form[:benefits]}>
            <div class="mt-2 grid gap-3 rounded-xl bg-slate-50 p-4 ring-1 ring-inset ring-slate-200 sm:grid-cols-[minmax(0,1.5fr)_minmax(0,0.6fr)_minmax(0,0.8fr)]">
              <.input
                field={benefit_form[:benefit_offer_version_id]}
                type="select"
                label={gettext("Benefit")}
                options={@benefit_options}
              />
              <.input
                field={benefit_form[:allowance_per_cycle]}
                type="number"
                label={gettext("Uses per cycle")}
                min="1"
              />
              <.input
                field={benefit_form[:consumption_unit]}
                type="select"
                label={gettext("Consumption")}
                options={[
                  {gettext("Per place"), "per_place"},
                  {gettext("Shared scope"), "shared_scope"}
                ]}
              />
            </div>
          </.inputs_for>
        </fieldset>

        <div class="flex items-end sm:col-span-2 sm:justify-end lg:col-span-3">
          <button
            id="publish-product-offering"
            type="submit"
            class="inline-flex h-11 items-center justify-center rounded-xl bg-clubeira-orange px-6 text-sm font-bold text-white transition hover:bg-orange-600"
          >
            {gettext("Publish offering")}
          </button>
        </div>
      </.form>
    </section>

    <.form
      for={@filter_form}
      id="product-offering-filters"
      phx-submit="filter"
      class="mt-7 grid gap-3 rounded-xl border border-clubeira-line bg-white p-4 sm:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)_auto_auto] sm:items-end"
    >
      <.input
        field={@filter_form[:status]}
        type="select"
        label={gettext("Status")}
        options={[
          {gettext("All statuses"), ""},
          {gettext("Draft"), "draft"},
          {gettext("Active"), "active"},
          {gettext("Paused"), "paused"},
          {gettext("Retired"), "retired"}
        ]}
      />
      <.input field={@filter_form[:code]} type="text" label={gettext("Exact code")} />
      <button
        id="apply-product-offering-filters"
        type="submit"
        class="inline-flex h-11 items-center justify-center rounded-xl bg-clubeira-orange px-5 text-sm font-bold text-white"
      >
        {gettext("Apply filters")}
      </button>
      <.link
        patch={~p"/admin/commercial/offerings?#{[polo: @current_polo.slug]}"}
        class="inline-flex h-11 items-center justify-center rounded-xl border border-clubeira-line px-4 text-sm font-bold text-slate-600"
      >
        {gettext("Clear filters")}
      </.link>
    </.form>

    <section class="mt-7 overflow-hidden rounded-xl border border-clubeira-line bg-white">
      <div id="product-offerings-inventory" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="product-offerings-empty"
          class="hidden only:flex items-center gap-3 px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-rectangle-stack" class="size-5 text-slate-300" />
          {gettext("No offerings match this inventory.")}
        </div>

        <article
          :for={{id, offering} <- @streams.product_offerings}
          id={id}
          data-offering-code={offering.code}
          class="grid gap-5 px-5 py-5 sm:px-6 xl:grid-cols-[minmax(0,1fr)_minmax(0,0.8fr)_minmax(330px,0.9fr)] xl:items-start"
        >
          <div class="min-w-0">
            <%= if offering.latest_version do %>
              <h2
                data-version-status="published"
                class="truncate text-sm font-bold text-slate-950"
              >
                {offering.latest_version.name}
              </h2>
            <% else %>
              <h2 data-version-status="missing" class="truncate text-sm font-bold text-slate-500">
                {gettext("No published version")}
              </h2>
            <% end %>
            <p class="mt-1 truncate text-xs text-slate-400">{offering.code}</p>
            <span
              data-status={offering.status}
              class="mt-3 inline-flex rounded-full bg-slate-100 px-3 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-700"
            >
              {status_label(offering.status)}
            </span>
          </div>

          <div>
            <%= if offering.latest_version do %>
              <p class="text-sm font-bold text-slate-700">
                {offering.latest_version.cycle_interval_count} {offering.latest_version.cycle_interval_unit}
              </p>
              <p class="mt-1 text-xs text-slate-400">
                {length(offering.latest_version.prices)} {gettext("published price(s)")}
              </p>
            <% else %>
              <p class="text-sm text-slate-400">
                {gettext("Complete publication to activate pricing and benefits.")}
              </p>
            <% end %>
          </div>

          <div :if={Map.has_key?(@lifecycle_forms, offering.id)}>
            <% lifecycle_form = Map.fetch!(@lifecycle_forms, offering.id) %>
            <.form
              for={lifecycle_form}
              id={"product-offering-lifecycle-form-#{offering.id}"}
              phx-submit="transition_product_offering"
              class="grid gap-3 rounded-xl bg-slate-50 p-4 ring-1 ring-inset ring-slate-200"
            >
              <input type="hidden" name="offering_id" value={offering.id} />
              <.input
                field={lifecycle_form[:idempotency_key]}
                id={"product-offering-lifecycle-idempotency-key-#{offering.id}"}
                type="hidden"
              />
              <.input
                field={lifecycle_form[:action]}
                id={"product-offering-lifecycle-action-#{offering.id}"}
                type="select"
                label={gettext("Lifecycle action")}
                prompt={gettext("Select an action")}
                options={lifecycle_options(offering.status)}
              />
              <.input
                field={lifecycle_form[:reason]}
                id={"product-offering-lifecycle-reason-#{offering.id}"}
                type="textarea"
                label={gettext("Reason")}
                minlength="3"
                maxlength="500"
              />
              <button
                id={"product-offering-lifecycle-submit-#{offering.id}"}
                type="submit"
                class="inline-flex h-10 items-center justify-center rounded-xl bg-slate-950 px-4 text-sm font-bold text-white"
              >
                {gettext("Apply action")}
              </button>
            </.form>
          </div>
        </article>
      </div>
    </section>

    <nav :if={@next_page_path} id="product-offerings-pagination" class="mt-5 flex justify-end">
      <.link
        id="product-offerings-next-page"
        patch={@next_page_path}
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-clubeira-orange px-5 text-sm font-bold text-white"
      >
        {gettext("Next page")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </nav>
  </div>
</BackofficeComponents.shell>
