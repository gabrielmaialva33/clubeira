<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:overview}
>
  <div class="mx-auto max-w-[1500px]">
    <section class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
          <span class="size-1.5 rounded-full bg-orange-500" />
          {gettext("Operational overview")}
        </div>
        <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] text-slate-950 sm:text-4xl">
          {gettext("Everything that moves %{polo}", polo: @current_polo.name)}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          {gettext("A current, capability-aware view of your club operation.")}
        </p>
      </div>
      <div class="inline-flex w-fit items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2 text-xs font-bold text-emerald-700">
        <span class="size-2 rounded-full bg-emerald-500 shadow-[0_0_0_4px_rgba(16,185,129,.12)]" />
        {gettext("Operation online")}
      </div>
    </section>

    <section class="relative mt-7 overflow-hidden rounded-[26px] bg-[#0b2342] px-6 py-7 text-white shadow-[0_20px_60px_rgba(8,27,51,.14)] sm:px-8 sm:py-8">
      <div class="absolute inset-y-0 right-0 w-1/2 bg-[radial-gradient(circle_at_center,rgba(37,99,235,.35),transparent_62%)]" />
      <div class="absolute -right-16 -top-16 size-48 rounded-full border-[32px] border-orange-500/20" />
      <div class="relative grid gap-7 lg:grid-cols-[1.05fr_1fr] lg:items-end">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.19em] text-blue-200">
            {gettext("Today in Clubeira")}
          </p>
          <h2 class="mt-3 max-w-xl text-2xl font-black tracking-[-0.035em] sm:text-3xl">
            {gettext("Decisions with context, without losing tenant isolation.")}
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-6 text-slate-300">
            {gettext(
              "Every module below reflects the roles currently authorized for this account and polo."
            )}
          </p>
        </div>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-2.5">
          <div
            id="metric-authorized-areas"
            class="rounded-2xl border border-white/10 bg-white/[0.07] p-4 backdrop-blur"
          >
            <p class="text-2xl font-black">{length(@current_polo.capabilities)}</p>
            <p class="mt-1 text-[11px] font-semibold text-slate-300">
              {gettext("Authorized areas")}
            </p>
          </div>
          <div
            :if={capability?(@current_polo, :manage_partners)}
            id="metric-recent-places"
            class="rounded-2xl border border-white/10 bg-white/[0.07] p-4 backdrop-blur"
          >
            <p class="text-2xl font-black">{@preview_counts.places}</p>
            <p class="mt-1 text-[11px] font-semibold text-slate-300">
              {gettext("Recent places")}
            </p>
          </div>
          <div
            :if={capability?(@current_polo, :manage_billing)}
            id="metric-recent-subscriptions"
            class="rounded-2xl border border-white/10 bg-white/[0.07] p-4 backdrop-blur"
          >
            <p class="text-2xl font-black">{@preview_counts.subscriptions}</p>
            <p class="mt-1 text-[11px] font-semibold text-slate-300">
              {gettext("Recent contracts")}
            </p>
          </div>
          <div
            :if={capability?(@current_polo, :manage_billing)}
            id="metric-recent-payments"
            class="rounded-2xl border border-orange-300/20 bg-orange-500/15 p-4 backdrop-blur"
          >
            <p class="text-2xl font-black text-orange-300">{@preview_counts.payments}</p>
            <p class="mt-1 text-[11px] font-semibold text-orange-100">
              {gettext("Recent payments")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <div
      :if={@load_errors != []}
      id="dashboard-load-errors"
      class="mt-6 flex items-start gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900"
    >
      <.icon name="hero-exclamation-triangle" class="mt-0.5 size-5 shrink-0" />
      <p>{gettext("Some operational sections could not be loaded. Try refreshing the page.")}</p>
    </div>

    <section class="mt-7 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <div
        :if={capability?(@current_polo, :manage_partners)}
        id="capability-manage-partners"
        class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] transition hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-[0_16px_38px_rgba(37,99,235,.08)]"
      >
        <span class="grid size-11 place-items-center rounded-xl bg-blue-50 text-blue-600 transition group-hover:bg-blue-600 group-hover:text-white">
          <.icon name="hero-building-storefront" class="size-5" />
        </span>
        <h3 class="mt-5 text-sm font-black text-slate-900">{gettext("Partner network")}</h3>
        <p class="mt-1.5 text-xs leading-5 text-slate-500">
          {gettext("Places, profiles and commercial catalog.")}
        </p>
      </div>

      <div
        :if={capability?(@current_polo, :manage_billing)}
        id="capability-manage-billing"
        class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] transition hover:-translate-y-0.5 hover:border-orange-200 hover:shadow-[0_16px_38px_rgba(249,115,22,.08)]"
      >
        <span class="grid size-11 place-items-center rounded-xl bg-orange-50 text-orange-600 transition group-hover:bg-orange-500 group-hover:text-white">
          <.icon name="hero-banknotes" class="size-5" />
        </span>
        <h3 class="mt-5 text-sm font-black text-slate-900">{gettext("Billing")}</h3>
        <p class="mt-1.5 text-xs leading-5 text-slate-500">
          {gettext("Payments, subscriptions and financial health.")}
        </p>
      </div>

      <div
        :if={capability?(@current_polo, :moderate_reviews)}
        id="capability-moderate-reviews"
        class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] transition hover:-translate-y-0.5 hover:border-cyan-200"
      >
        <span class="grid size-11 place-items-center rounded-xl bg-cyan-50 text-cyan-600 transition group-hover:bg-cyan-600 group-hover:text-white">
          <.icon name="hero-chat-bubble-left-right" class="size-5" />
        </span>
        <h3 class="mt-5 text-sm font-black text-slate-900">{gettext("Reputation")}</h3>
        <p class="mt-1.5 text-xs leading-5 text-slate-500">
          {gettext("Verified reviews and moderation queue.")}
        </p>
      </div>

      <div
        :if={capability?(@current_polo, :manage_operations)}
        id="capability-manage-operations"
        class="group rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] transition hover:-translate-y-0.5 hover:border-violet-200"
      >
        <span class="grid size-11 place-items-center rounded-xl bg-violet-50 text-violet-600 transition group-hover:bg-violet-600 group-hover:text-white">
          <.icon name="hero-command-line" class="size-5" />
        </span>
        <h3 class="mt-5 text-sm font-black text-slate-900">{gettext("Operations")}</h3>
        <p class="mt-1.5 text-xs leading-5 text-slate-500">
          {gettext("Outbox, retries and audit trail.")}
        </p>
      </div>
    </section>

    <div class="mt-7 grid gap-6 xl:grid-cols-[1.05fr_0.95fr]">
      <section
        :if={capability?(@current_polo, :manage_partners)}
        id="places-section"
        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]"
      >
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6">
          <div>
            <h2 class="text-sm font-black text-slate-900">{gettext("Partner places")}</h2>
            <p class="mt-1 text-xs text-slate-500">{gettext("Latest polo participations")}</p>
          </div>
          <span class="rounded-lg bg-blue-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-blue-700">
            {gettext("Live data")}
          </span>
        </div>
        <div id="places-feed" phx-update="stream" class="divide-y divide-slate-100">
          <div
            id="places-empty"
            class="hidden only:flex items-center gap-3 px-6 py-8 text-sm text-slate-500"
          >
            <.icon name="hero-building-storefront" class="size-5 text-slate-300" />
            {gettext("No places available in this polo.")}
          </div>
          <div
            :for={{id, place} <- @streams.places}
            id={id}
            class="flex items-center gap-4 px-5 py-4 transition hover:bg-slate-50/80 sm:px-6"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-slate-100 text-xs font-black text-slate-600">
              {place.place.name |> String.first() |> String.upcase()}
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-bold text-slate-900">{place.place.name}</p>
              <p class="mt-0.5 truncate text-xs text-slate-400">{place.place.slug}</p>
            </div>
            <span class={[
              "rounded-full px-2.5 py-1 text-[10px] font-bold ring-1 ring-inset",
              status_class(place.status)
            ]}>
              {status_label(place.status)}
            </span>
          </div>
        </div>
      </section>

      <section
        :if={capability?(@current_polo, :manage_billing)}
        id="payments-section"
        class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]"
      >
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6">
          <div>
            <h2 class="text-sm font-black text-slate-900">{gettext("Recent payments")}</h2>
            <p class="mt-1 text-xs text-slate-500">
              {gettext("Latest recorded financial events")}
            </p>
          </div>
          <span class="rounded-lg bg-orange-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-orange-700">
            {gettext("Finance")}
          </span>
        </div>
        <div id="payments-feed" phx-update="stream" class="divide-y divide-slate-100">
          <div
            id="payments-empty"
            class="hidden only:flex items-center gap-3 px-6 py-8 text-sm text-slate-500"
          >
            <.icon name="hero-banknotes" class="size-5 text-slate-300" />
            {gettext("No payments recorded in this polo.")}
          </div>
          <div
            :for={{id, payment} <- @streams.payments}
            id={id}
            class="flex items-center gap-4 px-5 py-4 transition hover:bg-slate-50/80 sm:px-6"
          >
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-orange-50 text-orange-600">
              <.icon name="hero-arrow-trending-up" class="size-5" />
            </span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-bold text-slate-900">
                {money(payment.amount, payment.currency, @locale)}
              </p>
              <p class="mt-0.5 truncate text-xs text-slate-400">
                {payment.order.order_number} · {timestamp(payment.recorded_at, @locale)}
              </p>
            </div>
            <span class={[
              "rounded-full px-2.5 py-1 text-[10px] font-bold ring-1 ring-inset",
              status_class(payment.status)
            ]}>
              {status_label(payment.status)}
            </span>
          </div>
        </div>
      </section>
    </div>

    <section
      :if={capability?(@current_polo, :manage_billing)}
      id="subscriptions-section"
      class="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]"
    >
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4 sm:px-6">
        <div>
          <h2 class="text-sm font-black text-slate-900">{gettext("Recent subscriptions")}</h2>
          <p class="mt-1 text-xs text-slate-500">
            {gettext("Current contract and benefit-cycle snapshot")}
          </p>
        </div>
      </div>
      <div id="subscriptions-feed" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="subscriptions-empty"
          class="hidden only:flex items-center gap-3 px-6 py-8 text-sm text-slate-500"
        >
          <.icon name="hero-user-group" class="size-5 text-slate-300" />
          {gettext("No subscriptions recorded in this polo.")}
        </div>
        <div
          :for={{id, subscription} <- @streams.subscriptions}
          id={id}
          class="grid gap-3 px-5 py-4 transition hover:bg-slate-50/80 sm:grid-cols-[1.2fr_1fr_auto] sm:items-center sm:px-6"
        >
          <div class="min-w-0">
            <p class="truncate text-sm font-bold text-slate-900">{subscription.offering.name}</p>
            <p class="mt-0.5 truncate text-xs text-slate-400">
              {subscription.order.order_number}
            </p>
          </div>
          <div class="text-xs text-slate-500">
            <span class="font-bold text-slate-700">{subscription.balance.available_units}</span>
            {gettext("available units")}
          </div>
          <span class={[
            "w-fit rounded-full px-2.5 py-1 text-[10px] font-bold ring-1 ring-inset",
            status_class(subscription.status)
          ]}>
            {status_label(subscription.status)}
          </span>
        </div>
      </div>
    </section>
  </div>
</BackofficeComponents.shell>
