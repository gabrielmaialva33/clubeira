<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:subscriptions}
>
  <div id="subscription-detail" class="mx-auto max-w-[1180px]">
    <.link
      id="back-to-subscriptions"
      navigate={~p"/admin/subscriptions?#{[polo: @current_polo.slug]}"}
      class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 transition hover:text-blue-700"
    >
      <.icon name="hero-arrow-left" class="size-4" />
      {gettext("Back to subscriptions")}
    </.link>

    <header class="mt-6 flex flex-col gap-5 rounded-[26px] bg-[#0b2342] px-6 py-7 text-white shadow-[0_20px_60px_rgba(8,27,51,.14)] sm:px-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
          {gettext("Member operation")}
        </p>
        <h1
          id="subscription-detail-offering"
          class="mt-2 truncate text-3xl font-black tracking-[-0.045em] sm:text-4xl"
        >
          {@subscription.offering.name}
        </h1>
        <p class="mt-2 break-all text-xs text-slate-400">{@subscription.id}</p>
      </div>

      <span
        id="subscription-detail-status"
        data-status={@subscription.status}
        class="w-fit rounded-full bg-white/10 px-3 py-1.5 text-xs font-bold ring-1 ring-inset ring-white/10"
      >
        {status_label(@subscription.status)}
      </span>
    </header>

    <section class="mt-7 grid gap-5 lg:grid-cols-2">
      <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Order")}
        </p>
        <h2
          id="subscription-detail-order"
          class="mt-3 break-all text-lg font-black text-slate-950"
        >
          {@subscription.order.order_number}
        </h2>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Order status")}</dt>
            <dd
              id="subscription-detail-order-status"
              data-status={@subscription.order.status}
              class="font-black text-slate-900"
            >
              {order_status_label(@subscription.order.status)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Placed at")}</dt>
            <dd id="subscription-detail-placed-at" class="text-right text-slate-900">
              {timestamp(@subscription.order.placed_at, @locale)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Activated at")}</dt>
            <dd id="subscription-detail-activated-at" class="text-right text-slate-900">
              {timestamp(@subscription.activated_at, @locale)}
            </dd>
          </div>
        </dl>
      </article>

      <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Current cycle")}
        </p>
        <%= if @subscription.current_cycle do %>
          <h2 class="mt-3 text-lg font-black text-slate-950">
            {gettext("Cycle %{sequence}", sequence: @subscription.current_cycle.sequence)}
          </h2>
          <p class="mt-2 text-sm text-slate-500">
            {timestamp(@subscription.current_cycle.starts_at, @locale)} — {timestamp(
              @subscription.current_cycle.ends_at,
              @locale
            )}
          </p>
        <% else %>
          <h2 class="mt-3 text-lg font-black text-slate-950">{gettext("No current cycle")}</h2>
        <% end %>

        <dl class="mt-5 grid grid-cols-3 gap-2">
          <div class="rounded-xl bg-slate-50 px-3 py-3">
            <dt class="text-[9px] font-bold uppercase tracking-wider text-slate-400">
              {gettext("Issued")}
            </dt>
            <dd class="mt-1 text-lg font-black text-slate-800">
              {@subscription.balance.issued_units}
            </dd>
          </div>
          <div class="rounded-xl bg-emerald-50 px-3 py-3">
            <dt class="text-[9px] font-bold uppercase tracking-wider text-emerald-600">
              {gettext("Available")}
            </dt>
            <dd class="mt-1 text-lg font-black text-emerald-700">
              {@subscription.balance.available_units}
            </dd>
          </div>
          <div class="rounded-xl bg-orange-50 px-3 py-3">
            <dt class="text-[9px] font-bold uppercase tracking-wider text-orange-600">
              {gettext("Consumed")}
            </dt>
            <dd class="mt-1 text-lg font-black text-orange-700">
              {@subscription.balance.consumed_units}
            </dd>
          </div>
        </dl>
      </article>
    </section>

    <section class="mt-5 rounded-[26px] border border-slate-200 bg-white p-6 shadow-[0_12px_40px_rgba(15,23,42,.045)] sm:p-8">
      <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.72fr)] lg:items-start">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-600">
            {gettext("Contract operation")}
          </p>
          <h2 class="mt-2 text-2xl font-black tracking-[-0.035em] text-slate-950">
            {gettext("Subscription lifecycle")}
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-6 text-slate-500">
            {gettext(
              "Lifecycle actions are authorized again in the database and recorded with idempotency, audit and domain events."
            )}
          </p>
        </div>

        <%= if @lifecycle_form do %>
          <.form
            for={@lifecycle_form}
            id={"subscription-lifecycle-form-#{@lifecycle_form[:idempotency_key].value}"}
            phx-submit="transition_contract"
            class="rounded-2xl bg-slate-50 p-4 ring-1 ring-inset ring-slate-200"
          >
            <.input
              field={@lifecycle_form[:action]}
              type="select"
              label={gettext("Action")}
              options={@lifecycle_actions}
              required
            />
            <div id="subscription-lifecycle-reason-field">
              <.input
                field={@lifecycle_form[:reason]}
                id={"subscription-lifecycle-reason-#{@lifecycle_form[:idempotency_key].value}"}
                type="textarea"
                label={gettext("Operational reason")}
                minlength="3"
                maxlength="500"
                required
              />
            </div>
            <.input field={@lifecycle_form[:idempotency_key]} type="hidden" />

            <button
              id="subscription-lifecycle-submit"
              type="submit"
              phx-disable-with={gettext("Updating...")}
              class="inline-flex w-full items-center justify-center rounded-xl bg-orange-500 px-4 py-3 text-sm font-black text-white shadow-[0_10px_28px_rgba(249,115,22,.22)] transition hover:bg-orange-600 disabled:cursor-wait disabled:opacity-70"
            >
              {gettext("Update subscription")}
            </button>
          </.form>
        <% else %>
          <div
            id="subscription-lifecycle-unavailable"
            class="rounded-2xl bg-slate-100 px-4 py-4 text-sm font-semibold text-slate-600"
          >
            {gettext("This subscription has no available lifecycle actions.")}
          </div>
        <% end %>
      </div>
    </section>
  </div>
</BackofficeComponents.shell>
