<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:payments}
>
  <div id="payments-page" class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
          {gettext("Financial operation")}
        </p>
        <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] text-slate-950 sm:text-4xl">
          {gettext("Finance")}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          {gettext("Payments, refunds and chargebacks for the selected polo.")}
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm shadow-sm">
        <span class="font-black text-slate-950">{@page.limit}</span>
        <span class="ml-1 text-slate-500">{gettext("items per page")}</span>
      </div>
    </header>

    <.form
      for={@filter_form}
      id="payment-filters"
      phx-submit="filter"
      class="mt-7 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)_auto_auto] sm:items-end"
    >
      <.input
        field={@filter_form[:status]}
        type="select"
        label={gettext("Payment status")}
        options={[
          {gettext("All statuses"), ""},
          {gettext("Authorized"), "authorized"},
          {gettext("Captured"), "captured"},
          {gettext("Failed"), "failed"},
          {gettext("Cancelled"), "cancelled"},
          {gettext("Refunded"), "refunded"},
          {gettext("Charged back"), "charged_back"}
        ]}
      />

      <.input
        field={@filter_form[:order_number]}
        type="text"
        label={gettext("Order number")}
        placeholder={gettext("Exact order number")}
        maxlength="128"
        autocomplete="off"
      />

      <button
        id="apply-payment-filters"
        type="submit"
        class="inline-flex h-11 items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-bold text-white shadow-[0_10px_24px_rgba(37,99,235,.2)] transition hover:bg-blue-700"
      >
        {gettext("Apply filters")}
      </button>

      <.link
        patch={~p"/admin/payments?#{[polo: @current_polo.slug]}"}
        class="inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 px-4 text-sm font-bold text-slate-600 transition hover:border-blue-200 hover:text-blue-700"
      >
        {gettext("Clear filters")}
      </.link>
    </.form>

    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]">
      <div id="payments-inventory" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="payments-inventory-empty"
          class="hidden only:flex items-center gap-3 px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-banknotes" class="size-5 text-slate-300" />
          {gettext("No payments match this inventory.")}
        </div>

        <article
          :for={{id, payment} <- @streams.payments}
          id={id}
          class="grid gap-5 px-5 py-5 transition hover:bg-slate-50/80 sm:px-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,0.8fr)_minmax(0,0.8fr)_auto] lg:items-center"
        >
          <div class="min-w-0">
            <.link
              id={"payment-link-#{payment.id}"}
              navigate={~p"/admin/payments/#{payment.id}?#{[polo: @current_polo.slug]}"}
              class="group/link inline-flex max-w-full items-center gap-1.5 text-sm font-black text-slate-950 transition hover:text-blue-700"
            >
              <span class="truncate">{payment.order.order_number}</span>
              <.icon
                name="hero-arrow-up-right"
                class="size-3.5 shrink-0 text-slate-300 transition group-hover/link:text-blue-600"
              />
            </.link>
            <p class="mt-1 truncate text-xs text-slate-400">{payment.provider_code}</p>
          </div>

          <p class="text-sm font-black text-slate-900">
            {money(payment.amount, payment.currency, @locale)}
          </p>

          <div class="text-xs text-slate-500">
            <p>{payment.payment_method || gettext("Not available")}</p>
            <p :if={payment.refund} class="mt-1 font-bold text-orange-600">
              {gettext("Refund: %{status}", status: payment.refund.status)}
            </p>
            <p :if={payment.chargeback} class="mt-1 font-bold text-red-600">
              {gettext("Chargeback: %{status}", status: payment.chargeback.status)}
            </p>
          </div>

          <span class={[
            "w-fit rounded-full px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide ring-1 ring-inset",
            status_class(payment.status)
          ]}>
            {status_label(payment.status)}
          </span>
        </article>
      </div>
    </section>

    <nav
      :if={@next_page_path}
      id="payments-pagination"
      class="mt-5 flex items-center justify-end"
      aria-label={gettext("Inventory pagination")}
    >
      <.link
        id="payments-next-page"
        patch={@next_page_path}
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-bold text-white shadow-[0_10px_24px_rgba(37,99,235,.2)] transition hover:bg-blue-700"
      >
        {gettext("Next page")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </nav>
  </div>
</BackofficeComponents.shell>
