<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:places}
>
  <div id="places-page" class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-600">
          {gettext("Partner network")}
        </p>
        <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] text-slate-950 sm:text-4xl">
          {gettext("Places")}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          {gettext("Operational participation and public-profile inventory for this polo.")}
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm shadow-sm">
        <span class="font-black text-slate-950">{@page.limit}</span>
        <span class="ml-1 text-slate-500">{gettext("items per page")}</span>
      </div>
    </header>

    <.form
      for={@filter_form}
      id="place-filters"
      phx-change="filter"
      class="mt-7 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto] sm:items-end"
    >
      <div>
        <label for={@filter_form[:status].id} class="text-xs font-bold text-slate-700">
          {gettext("Participation status")}
        </label>
        <select
          id={@filter_form[:status].id}
          name={@filter_form[:status].name}
          class="mt-2 h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
        >
          <option value="" selected={@filter_form[:status].value == ""}>
            {gettext("All statuses")}
          </option>
          <option value="invited" selected={@filter_form[:status].value == "invited"}>
            {gettext("Invited")}
          </option>
          <option value="active" selected={@filter_form[:status].value == "active"}>
            {gettext("Active")}
          </option>
          <option value="suspended" selected={@filter_form[:status].value == "suspended"}>
            {gettext("Suspended")}
          </option>
          <option value="retired" selected={@filter_form[:status].value == "retired"}>
            {gettext("Retired")}
          </option>
        </select>
      </div>

      <div>
        <label for={@filter_form[:profile_status].id} class="text-xs font-bold text-slate-700">
          {gettext("Public profile")}
        </label>
        <select
          id={@filter_form[:profile_status].id}
          name={@filter_form[:profile_status].name}
          class="mt-2 h-11 w-full rounded-xl border border-slate-200 bg-white px-3 text-sm text-slate-700 outline-none transition focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
        >
          <option value="" selected={@filter_form[:profile_status].value == ""}>
            {gettext("All profiles")}
          </option>
          <option value="missing" selected={@filter_form[:profile_status].value == "missing"}>
            {gettext("Missing profile")}
          </option>
          <option value="published" selected={@filter_form[:profile_status].value == "published"}>
            {gettext("Published profile")}
          </option>
        </select>
      </div>

      <.link
        patch={~p"/admin/places?#{[polo: @current_polo.slug]}"}
        class="inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 px-4 text-sm font-bold text-slate-600 transition hover:border-blue-200 hover:text-blue-700"
      >
        {gettext("Clear filters")}
      </.link>
    </.form>

    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]">
      <div id="places-inventory" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="places-inventory-empty"
          class="hidden only:flex items-center gap-3 px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-building-storefront" class="size-5 text-slate-300" />
          {gettext("No places match this inventory.")}
        </div>

        <article
          :for={{id, participation} <- @streams.places}
          id={id}
          class="grid gap-4 px-5 py-5 transition hover:bg-slate-50/80 sm:px-6 lg:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)_auto] lg:items-center"
        >
          <div class="flex min-w-0 items-center gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-sm font-black text-blue-700">
              {participation.place.name |> String.first() |> String.upcase()}
            </span>
            <div class="min-w-0">
              <.link
                id={"place-link-#{participation.id}"}
                navigate={~p"/admin/places/#{participation.id}?#{[polo: @current_polo.slug]}"}
                class="group block"
              >
                <h2 class="truncate text-sm font-black text-slate-950 transition group-hover:text-blue-700">
                  {participation.place.name}
                </h2>
                <p class="mt-1 truncate text-xs text-slate-400">{participation.place.slug}</p>
              </.link>
            </div>
          </div>

          <div>
            <p class="text-xs font-bold text-slate-700">{profile_label(participation.profile)}</p>
            <p :if={participation.profile} class="mt-1 truncate text-xs text-slate-400">
              {participation.profile.public_email}
            </p>
            <p :if={!participation.profile} class="mt-1 text-xs text-slate-400">
              {gettext("Public contact has not been configured yet.")}
            </p>
          </div>

          <span class="w-fit rounded-full bg-slate-100 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide text-slate-700 ring-1 ring-inset ring-slate-500/10">
            {status_label(participation.status)}
          </span>
        </article>
      </div>
    </section>

    <nav
      :if={@next_page_path}
      id="places-pagination"
      class="mt-5 flex items-center justify-end"
      aria-label={gettext("Inventory pagination")}
    >
      <.link
        id="places-next-page"
        patch={@next_page_path}
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-bold text-white shadow-[0_10px_24px_rgba(37,99,235,.2)] transition hover:bg-blue-700"
      >
        {gettext("Next page")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </nav>
  </div>
</BackofficeComponents.shell>
