<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:places}
>
  <div id="place-detail" class="mx-auto max-w-[1180px]">
    <.link
      id="back-to-places"
      navigate={~p"/admin/places?#{[polo: @current_polo.slug]}"}
      class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 transition hover:text-blue-700"
    >
      <.icon name="hero-arrow-left" class="size-4" />
      {gettext("Back to places")}
    </.link>

    <header class="clubeira-ticket-rail clubeira-grid-paper mt-5 flex flex-col gap-5 rounded-xl border border-clubeira-line bg-white px-6 py-6 sm:px-7 lg:flex-row lg:items-center lg:justify-between">
      <div>
        <p class="clubeira-page-kicker">
          {gettext("Place operation")}
        </p>
        <h1
          id="place-detail-name"
          class="clubeira-page-title mt-1.5"
        >
          {@place.place.name}
        </h1>
        <p class="mt-2 text-sm text-clubeira-muted">{@place.place.slug}</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span
          id="place-detail-status"
          data-status={@place.status}
          class="rounded-lg bg-clubeira-blue-soft px-3 py-1.5 text-xs font-bold text-clubeira-blue"
        >
          {status_label(@place.status)}
        </span>
        <span class="rounded-lg bg-clubeira-orange-soft px-3 py-1.5 text-xs font-bold text-clubeira-orange">
          {gettext("Revision")}
          <span id="place-detail-revision">{@place.revision}</span>
        </span>
      </div>
    </header>

    <section class="mt-7 grid gap-5 lg:grid-cols-2">
      <article class="rounded-xl border border-clubeira-line bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Public profile")}
        </p>
        <h2 class="mt-3 text-lg font-bold text-slate-950">{profile_label(@place.profile)}</h2>
        <%= if @place.profile do %>
          <dl class="mt-5 space-y-3 text-sm">
            <div class="flex items-center justify-between gap-4">
              <dt class="font-bold text-slate-500">{gettext("Profile revision")}</dt>
              <dd id="place-profile-revision" class="font-bold text-blue-700">
                {@place.profile.revision}
              </dd>
            </div>
            <div>
              <dt class="font-bold text-slate-500">{gettext("Public email")}</dt>
              <dd class="mt-1 text-slate-900">{@place.profile.public_email}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-500">{gettext("Public phone")}</dt>
              <dd class="mt-1 text-slate-900">{@place.profile.public_phone}</dd>
            </div>
          </dl>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-slate-500">
            {gettext("This participation does not have a public profile yet.")}
          </p>
        <% end %>
      </article>

      <article class="rounded-xl border border-clubeira-line bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Participation")}
        </p>
        <h2 class="mt-3 text-lg font-bold text-slate-950">{status_label(@place.status)}</h2>
        <p class="mt-3 text-sm leading-6 text-slate-500">
          {gettext(
            "Lifecycle actions are protected by authorization, idempotency and revision checks."
          )}
        </p>

        <%= if @lifecycle_form do %>
          <.form
            for={@lifecycle_form}
            id="place-lifecycle-form"
            phx-submit="transition_place"
            class="mt-6"
          >
            <.input
              field={@lifecycle_form[:action]}
              type="select"
              label={gettext("Action")}
              options={@lifecycle_actions}
              required
            />
            <div id="place-lifecycle-reason-field">
              <.input
                field={@lifecycle_form[:reason]}
                type="textarea"
                label={gettext("Operational reason")}
                minlength="3"
                maxlength="500"
                required
              />
            </div>
            <.input field={@lifecycle_form[:expected_polo_place_id]} type="hidden" />
            <.input field={@lifecycle_form[:expected_revision]} type="hidden" />
            <.input field={@lifecycle_form[:idempotency_key]} type="hidden" />
            <.input
              field={@lifecycle_form[:confirm_retire]}
              type="checkbox"
              label={gettext("I understand that retiring this participation is permanent.")}
            />

            <button
              id="place-lifecycle-submit"
              type="submit"
              phx-disable-with={gettext("Updating...")}
              class="inline-flex w-full items-center justify-center rounded-xl bg-orange-500 px-4 py-3 text-sm font-bold text-white transition hover:bg-orange-600 disabled:cursor-wait disabled:opacity-70"
            >
              {gettext("Update participation")}
            </button>
          </.form>
        <% else %>
          <div
            id="place-lifecycle-unavailable"
            class="mt-6 rounded-xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-600"
          >
            {gettext("This participation has no available lifecycle actions.")}
          </div>
        <% end %>
      </article>
    </section>

    <section
      :if={@profile_form}
      id="place-profile-editor"
      class="mt-5 rounded-xl border border-clubeira-line bg-white p-6 sm:p-8"
    >
      <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-blue-600">
            {gettext("Directory publication")}
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-[-0.035em] text-slate-950">
            {gettext("Edit public profile")}
          </h2>
          <p class="clubeira-page-copy mt-1.5">
            {gettext(
              "Contact, categories and opening hours are replaced together as one audited revision."
            )}
          </p>
        </div>
        <span class="inline-flex w-fit items-center rounded-full bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700 ring-1 ring-inset ring-blue-100">
          {gettext("Atomic update")}
        </span>
      </div>

      <.form
        for={@profile_form}
        id="place-profile-form"
        phx-change="validate_profile"
        phx-submit="save_profile"
        class="mt-8 space-y-8"
      >
        <div class="grid gap-5 lg:grid-cols-2">
          <.input
            field={@profile_form[:public_email]}
            type="email"
            label={gettext("Public email")}
            autocomplete="email"
            maxlength="254"
            required
          />
          <.input
            field={@profile_form[:public_phone]}
            type="tel"
            label={gettext("Public phone")}
            autocomplete="tel"
            placeholder="(88) 99999-0101"
            required
          />
        </div>

        <div id="profile-category-field">
          <.input
            field={@profile_form[:category_keys]}
            type="select"
            label={gettext("Categories")}
            options={@profile_category_options}
            multiple
            size="5"
            required
          />
          <p class="-mt-2 text-xs leading-5 text-slate-500">
            {gettext("Use Ctrl or Command to select more than one category.")}
          </p>
        </div>

        <div id="profile-weekly-hours-section">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h3 class="text-base font-bold text-slate-950">{gettext("Weekly hours")}</h3>
              <p class="mt-1 text-xs text-slate-500">
                {gettext("Overnight windows close on the following day automatically.")}
              </p>
            </div>
            <button
              id="add-weekly-hour"
              type="button"
              name="profile[weekly_hours_sort][]"
              value="new"
              phx-click={JS.dispatch("change")}
              class="inline-flex items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-3 py-2 text-xs font-bold text-blue-700 transition hover:bg-blue-100"
            >
              <.icon name="hero-plus" class="size-4" />
              {gettext("Add window")}
            </button>
          </div>

          <div id="profile-weekly-hours" class="mt-4 space-y-3">
            <.inputs_for :let={weekly_form} field={@profile_form[:weekly_hours]}>
              <div
                id={"profile-weekly-hour-#{weekly_form.index}"}
                class="grid gap-3 rounded-xl border border-clubeira-line bg-slate-50/70 p-4 md:grid-cols-[1.2fr_1fr_1fr_auto] md:items-end"
              >
                <input
                  type="hidden"
                  name="profile[weekly_hours_sort][]"
                  value={weekly_form.index}
                />
                <.input
                  field={weekly_form[:weekday]}
                  type="select"
                  label={gettext("Weekday")}
                  options={weekday_options()}
                  required
                />
                <.input
                  field={weekly_form[:opens_at]}
                  type="time"
                  label={gettext("Opens at")}
                  required
                />
                <.input
                  field={weekly_form[:closes_at]}
                  type="time"
                  label={gettext("Closes at")}
                  required
                />
                <button
                  id={"remove-weekly-hour-#{weekly_form.index}"}
                  type="button"
                  name="profile[weekly_hours_drop][]"
                  value={weekly_form.index}
                  phx-click={JS.dispatch("change")}
                  class="mb-4 grid size-10 place-items-center rounded-xl border border-red-200 bg-white text-red-600 transition hover:bg-red-50"
                  aria-label={gettext("Remove weekly window")}
                >
                  <.icon name="hero-trash" class="size-4" />
                </button>
              </div>
            </.inputs_for>
          </div>
          <input type="hidden" name="profile[weekly_hours_drop][]" />
          <p
            :for={error <- @profile_form[:weekly_hours].errors}
            class="mt-2 text-sm font-semibold text-red-600"
          >
            {translate_error(error)}
          </p>
        </div>

        <div id="profile-special-hours-section">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h3 class="text-base font-bold text-slate-950">{gettext("Special dates")}</h3>
              <p class="mt-1 text-xs text-slate-500">
                {gettext("Override a date as closed or with custom windows.")}
              </p>
            </div>
            <button
              id="add-special-hour"
              type="button"
              name="profile[special_hours_sort][]"
              value="new"
              phx-click={JS.dispatch("change")}
              class="inline-flex items-center gap-2 rounded-xl border border-orange-200 bg-orange-50 px-3 py-2 text-xs font-bold text-orange-700 transition hover:bg-orange-100"
            >
              <.icon name="hero-plus" class="size-4" />
              {gettext("Add date")}
            </button>
          </div>

          <div id="profile-special-hours" class="mt-4 space-y-4">
            <.inputs_for :let={special_form} field={@profile_form[:special_hours]}>
              <div
                id={"profile-special-hour-#{special_form.index}"}
                class="rounded-xl border border-clubeira-line bg-slate-50/70 p-4"
              >
                <input
                  type="hidden"
                  name="profile[special_hours_sort][]"
                  value={special_form.index}
                />
                <div class="grid gap-3 md:grid-cols-[1fr_1fr_auto] md:items-end">
                  <.input
                    field={special_form[:local_date]}
                    type="date"
                    label={gettext("Date")}
                    required
                  />
                  <.input
                    field={special_form[:kind]}
                    type="select"
                    label={gettext("Schedule")}
                    options={[{gettext("Closed"), "closed"}, {gettext("Custom hours"), "custom"}]}
                    required
                  />
                  <button
                    id={"remove-special-hour-#{special_form.index}"}
                    type="button"
                    name="profile[special_hours_drop][]"
                    value={special_form.index}
                    phx-click={JS.dispatch("change")}
                    class="mb-4 grid size-10 place-items-center rounded-xl border border-red-200 bg-white text-red-600 transition hover:bg-red-50"
                    aria-label={gettext("Remove special date")}
                  >
                    <.icon name="hero-trash" class="size-4" />
                  </button>
                </div>

                <div
                  :if={special_form[:kind].value == "custom"}
                  id={"profile-special-windows-#{special_form.index}"}
                  class="mt-2 rounded-xl border border-dashed border-slate-300 bg-white p-3"
                >
                  <.inputs_for :let={window_form} field={special_form[:windows]}>
                    <div
                      id={"profile-special-window-#{special_form.index}-#{window_form.index}"}
                      class="grid gap-3 sm:grid-cols-[1fr_1fr_auto] sm:items-end"
                    >
                      <input
                        type="hidden"
                        name={"#{special_form.name}[windows_sort][]"}
                        value={window_form.index}
                      />
                      <.input
                        field={window_form[:opens_at]}
                        type="time"
                        label={gettext("Opens at")}
                        required
                      />
                      <.input
                        field={window_form[:closes_at]}
                        type="time"
                        label={gettext("Closes at")}
                        required
                      />
                      <button
                        id={"remove-special-window-#{special_form.index}-#{window_form.index}"}
                        type="button"
                        name={"#{special_form.name}[windows_drop][]"}
                        value={window_form.index}
                        phx-click={JS.dispatch("change")}
                        class="mb-4 grid size-10 place-items-center rounded-xl border border-red-200 text-red-600 transition hover:bg-red-50"
                        aria-label={gettext("Remove special window")}
                      >
                        <.icon name="hero-trash" class="size-4" />
                      </button>
                    </div>
                  </.inputs_for>
                  <input type="hidden" name={"#{special_form.name}[windows_drop][]"} />
                  <button
                    id={"add-special-window-#{special_form.index}"}
                    type="button"
                    name={"#{special_form.name}[windows_sort][]"}
                    value="new"
                    phx-click={JS.dispatch("change")}
                    class="mt-1 inline-flex items-center gap-2 text-xs font-bold text-blue-700"
                  >
                    <.icon name="hero-plus" class="size-4" />
                    {gettext("Add custom window")}
                  </button>
                </div>
              </div>
            </.inputs_for>
          </div>
          <input type="hidden" name="profile[special_hours_drop][]" />
          <p
            :for={error <- @profile_form[:special_hours].errors}
            class="mt-2 text-sm font-semibold text-red-600"
          >
            {translate_error(error)}
          </p>
        </div>

        <.input field={@profile_form[:expected_polo_place_id]} type="hidden" />
        <.input field={@profile_form[:expected_revision]} type="hidden" />
        <.input field={@profile_form[:idempotency_key]} type="hidden" />

        <div class="flex justify-end border-t border-clubeira-line pt-6">
          <button
            id="place-profile-submit"
            type="submit"
            phx-disable-with={gettext("Saving profile...")}
            class="inline-flex w-full items-center justify-center rounded-xl bg-clubeira-orange px-6 py-3 text-sm font-bold text-white transition hover:bg-orange-600 disabled:cursor-wait disabled:opacity-70 sm:w-auto"
          >
            {gettext("Save public profile")}
          </button>
        </div>
      </.form>
    </section>

    <section
      :if={!@profile_form}
      id="place-profile-editor-unavailable"
      class="mt-5 rounded-xl border border-clubeira-line bg-white px-6 py-5 text-sm font-semibold text-slate-500"
    >
      {gettext("The public profile can only be edited while the participation is active.")}
    </section>
  </div>
</BackofficeComponents.shell>
