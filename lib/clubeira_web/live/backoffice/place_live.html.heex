<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:places}
>
  <div id="place-detail" class="mx-auto max-w-[1180px]">
    <.link
      id="back-to-places"
      navigate={~p"/admin/places?#{[polo: @current_polo.slug]}"}
      class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 transition hover:text-blue-700"
    >
      <.icon name="hero-arrow-left" class="size-4" />
      {gettext("Back to places")}
    </.link>

    <header class="mt-6 flex flex-col gap-5 rounded-[26px] bg-[#0b2342] px-6 py-7 text-white shadow-[0_20px_60px_rgba(8,27,51,.14)] sm:px-8 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
          {gettext("Place operation")}
        </p>
        <h1
          id="place-detail-name"
          class="mt-2 text-3xl font-black tracking-[-0.045em] sm:text-4xl"
        >
          {@place.place.name}
        </h1>
        <p class="mt-2 text-sm text-slate-300">{@place.place.slug}</p>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span
          id="place-detail-status"
          data-status={@place.status}
          class="rounded-full bg-white/10 px-3 py-1.5 text-xs font-bold ring-1 ring-inset ring-white/10"
        >
          {status_label(@place.status)}
        </span>
        <span class="rounded-full bg-orange-500/15 px-3 py-1.5 text-xs font-bold text-orange-200 ring-1 ring-inset ring-orange-300/20">
          {gettext("Revision")}
          <span id="place-detail-revision">{@place.revision}</span>
        </span>
      </div>
    </header>

    <section class="mt-7 grid gap-5 lg:grid-cols-2">
      <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Public profile")}
        </p>
        <h2 class="mt-3 text-lg font-black text-slate-950">{profile_label(@place.profile)}</h2>
        <%= if @place.profile do %>
          <dl class="mt-5 space-y-3 text-sm">
            <div>
              <dt class="font-bold text-slate-500">{gettext("Public email")}</dt>
              <dd class="mt-1 text-slate-900">{@place.profile.public_email}</dd>
            </div>
            <div>
              <dt class="font-bold text-slate-500">{gettext("Public phone")}</dt>
              <dd class="mt-1 text-slate-900">{@place.profile.public_phone}</dd>
            </div>
          </dl>
        <% else %>
          <p class="mt-3 text-sm leading-6 text-slate-500">
            {gettext("This participation does not have a public profile yet.")}
          </p>
        <% end %>
      </article>

      <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Participation")}
        </p>
        <h2 class="mt-3 text-lg font-black text-slate-950">{status_label(@place.status)}</h2>
        <p class="mt-3 text-sm leading-6 text-slate-500">
          {gettext(
            "Lifecycle actions are protected by authorization, idempotency and revision checks."
          )}
        </p>

        <%= if @lifecycle_form do %>
          <.form
            for={@lifecycle_form}
            id="place-lifecycle-form"
            phx-submit="transition_place"
            class="mt-6"
          >
            <.input
              field={@lifecycle_form[:action]}
              type="select"
              label={gettext("Action")}
              options={@lifecycle_actions}
              required
            />
            <div id="place-lifecycle-reason-field">
              <.input
                field={@lifecycle_form[:reason]}
                type="textarea"
                label={gettext("Operational reason")}
                minlength="3"
                maxlength="500"
                required
              />
            </div>
            <.input field={@lifecycle_form[:expected_polo_place_id]} type="hidden" />
            <.input field={@lifecycle_form[:expected_revision]} type="hidden" />
            <.input field={@lifecycle_form[:idempotency_key]} type="hidden" />
            <.input
              field={@lifecycle_form[:confirm_retire]}
              type="checkbox"
              label={gettext("I understand that retiring this participation is permanent.")}
            />

            <button
              id="place-lifecycle-submit"
              type="submit"
              phx-disable-with={gettext("Updating...")}
              class="inline-flex w-full items-center justify-center rounded-xl bg-orange-500 px-4 py-3 text-sm font-black text-white shadow-[0_10px_28px_rgba(249,115,22,.22)] transition hover:bg-orange-600 disabled:cursor-wait disabled:opacity-70"
            >
              {gettext("Update participation")}
            </button>
          </.form>
        <% else %>
          <div
            id="place-lifecycle-unavailable"
            class="mt-6 rounded-xl bg-slate-100 px-4 py-3 text-sm font-semibold text-slate-600"
          >
            {gettext("This participation has no available lifecycle actions.")}
          </div>
        <% end %>
      </article>
    </section>
  </div>
</BackofficeComponents.shell>
