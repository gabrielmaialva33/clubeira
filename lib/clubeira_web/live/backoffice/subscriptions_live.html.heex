<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:subscriptions}
>
  <div id="subscriptions-page" class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="clubeira-page-kicker">
          {gettext("Member operation")}
        </p>
        <h1 class="clubeira-page-title mt-1.5">
          {gettext("Subscriptions")}
        </h1>
        <p class="clubeira-page-copy mt-1.5">
          {gettext("Current contract, cycle and entitlement balance for every subscription.")}
        </p>
      </div>
      <div class="rounded-xl border border-clubeira-line bg-white px-4 py-3 text-sm">
        <span class="font-bold text-slate-950">{@page.limit}</span>
        <span class="ml-1 text-slate-500">{gettext("items per page")}</span>
      </div>
    </header>

    <.form
      for={@filter_form}
      id="subscription-filters"
      phx-submit="filter"
      class="mt-7 grid gap-3 rounded-xl border border-clubeira-line bg-white p-4 sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)_auto_auto] sm:items-end"
    >
      <.input
        field={@filter_form[:status]}
        type="select"
        label={gettext("Contract status")}
        options={[
          {gettext("All statuses"), ""},
          {gettext("Pending"), "pending"},
          {gettext("Active"), "active"},
          {gettext("Past due"), "past_due"},
          {gettext("Suspended"), "suspended"},
          {gettext("Cancelled"), "cancelled"},
          {gettext("Expired"), "expired"}
        ]}
      />

      <.input
        field={@filter_form[:order_number]}
        type="text"
        label={gettext("Order number")}
        placeholder={gettext("Exact order number")}
        maxlength="128"
        autocomplete="off"
      />

      <button
        id="apply-subscription-filters"
        type="submit"
        class="inline-flex h-11 items-center justify-center rounded-xl bg-clubeira-orange px-5 text-sm font-bold text-white transition hover:bg-orange-600"
      >
        {gettext("Apply filters")}
      </button>

      <.link
        patch={~p"/admin/subscriptions?#{[polo: @current_polo.slug]}"}
        class="inline-flex h-11 items-center justify-center rounded-xl border border-clubeira-line px-4 text-sm font-bold text-slate-600 transition hover:border-blue-200 hover:text-blue-700"
      >
        {gettext("Clear filters")}
      </.link>
    </.form>

    <section class="mt-7 overflow-hidden rounded-xl border border-clubeira-line bg-white">
      <div id="subscriptions-inventory" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="subscriptions-inventory-empty"
          class="hidden only:flex items-center gap-3 px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-user-group" class="size-5 text-slate-300" />
          {gettext("No subscriptions match this inventory.")}
        </div>

        <article
          :for={{id, subscription} <- @streams.subscriptions}
          id={id}
          class="grid gap-5 px-5 py-5 transition hover:bg-slate-50/80 sm:px-6 xl:grid-cols-[minmax(0,1.3fr)_minmax(0,0.9fr)_minmax(250px,0.8fr)_auto] xl:items-center"
        >
          <div class="flex min-w-0 items-center gap-4">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-blue-50 text-blue-700">
              <.icon name="hero-identification" class="size-5" />
            </span>
            <div class="min-w-0">
              <.link
                id={"subscription-link-#{subscription.id}"}
                navigate={
                  ~p"/admin/subscriptions/#{subscription.id}?#{[polo: @current_polo.slug]}"
                }
                class="group/link inline-flex max-w-full items-center gap-1.5 text-sm font-bold text-slate-950 transition hover:text-blue-700"
              >
                <span class="truncate">{subscription.offering.name}</span>
                <.icon
                  name="hero-arrow-up-right"
                  class="size-3.5 shrink-0 text-slate-300 transition group-hover/link:text-blue-600"
                />
              </.link>
              <p class="mt-1 truncate text-xs text-slate-400">
                {subscription.order.order_number}
              </p>
            </div>
          </div>

          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">
              {gettext("Current cycle")}
            </p>
            <%= if subscription.current_cycle do %>
              <p class="mt-1 text-xs font-bold text-slate-700">
                {gettext("Cycle %{sequence}", sequence: subscription.current_cycle.sequence)}
              </p>
              <p class="mt-1 text-[11px] text-slate-400">
                {timestamp(subscription.current_cycle.ends_at, @locale)}
              </p>
            <% else %>
              <p class="mt-1 text-xs text-slate-400">{gettext("No current cycle")}</p>
            <% end %>
          </div>

          <dl class="grid grid-cols-3 gap-2">
            <div class="rounded-xl bg-slate-50 px-3 py-2.5">
              <dt class="text-[9px] font-bold uppercase tracking-wider text-slate-400">
                {gettext("Issued")}
              </dt>
              <dd class="mt-1 text-sm font-bold text-slate-800">
                {subscription.balance.issued_units}
              </dd>
            </div>
            <div class="rounded-xl bg-emerald-50 px-3 py-2.5">
              <dt class="text-[9px] font-bold uppercase tracking-wider text-emerald-600">
                {gettext("Available")}
              </dt>
              <dd class="mt-1 text-sm font-bold text-emerald-700">
                {subscription.balance.available_units}
              </dd>
            </div>
            <div class="rounded-xl bg-orange-50 px-3 py-2.5">
              <dt class="text-[9px] font-bold uppercase tracking-wider text-orange-600">
                {gettext("Consumed")}
              </dt>
              <dd class="mt-1 text-sm font-bold text-orange-700">
                {subscription.balance.consumed_units}
              </dd>
            </div>
          </dl>

          <span class={[
            "w-fit rounded-full px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide ring-1 ring-inset",
            status_class(subscription.status)
          ]}>
            {status_label(subscription.status)}
          </span>
        </article>
      </div>
    </section>

    <nav
      :if={@next_page_path}
      id="subscriptions-pagination"
      class="mt-5 flex items-center justify-end"
      aria-label={gettext("Inventory pagination")}
    >
      <.link
        id="subscriptions-next-page"
        patch={@next_page_path}
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-clubeira-orange px-5 text-sm font-bold text-white transition hover:bg-orange-600"
      >
        {gettext("Next page")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </nav>
  </div>
</BackofficeComponents.shell>
