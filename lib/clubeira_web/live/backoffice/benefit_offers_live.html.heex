<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:commercial}
>
  <div id="benefit-offers-page" class="mx-auto max-w-[1500px]">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
          {gettext("Commercial catalog")}
        </p>
        <h1 class="mt-2 text-3xl font-black tracking-[-0.045em] text-slate-950 sm:text-4xl">
          {gettext("Benefits")}
        </h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-500">
          {gettext("Publish immutable benefits before composing subscription offerings.")}
        </p>
      </div>
      <.link
        id="commercial-offerings-link"
        navigate={~p"/admin/commercial/offerings?#{[polo: @current_polo.slug]}"}
        class="inline-flex h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 text-sm font-bold text-slate-700 shadow-sm transition hover:border-blue-200 hover:text-blue-700"
      >
        {gettext("Subscription offerings")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </header>

    <section class="mt-7 rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:p-6">
      <div class="grid gap-5 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)]">
        <div>
          <h2 class="text-lg font-black text-slate-950">{gettext("Publish benefit")}</h2>
          <p class="mt-1 text-sm leading-6 text-slate-500">
            {gettext("The first version is published atomically with audit and outbox evidence.")}
          </p>

          <.form
            for={@place_form}
            id="benefit-place-form"
            phx-change="select_benefit_place"
            class="mt-5"
          >
            <.input
              field={@place_form[:id]}
              type="select"
              label={gettext("Available place")}
              options={Enum.map(@available_places, &{&1.place.name, &1.place.id})}
            />
          </.form>

          <div
            :if={!@selected_place}
            id="benefit-publication-without-place"
            class="mt-4 rounded-xl border border-orange-200 bg-orange-50 px-4 py-3 text-sm text-orange-800"
          >
            {gettext("An active place is required before a benefit can be published.")}
          </div>
        </div>

        <.form
          :if={@selected_place}
          for={@publish_form}
          id="benefit-offer-publish-form"
          phx-submit="publish_benefit_offer"
          class="grid gap-4 sm:grid-cols-2"
        >
          <.input field={@publish_form[:idempotency_key]} type="hidden" />
          <.input field={@publish_form[:code]} type="text" label={gettext("Code")} />
          <.input field={@publish_form[:name]} type="text" label={gettext("Name")} />
          <.input
            field={@publish_form[:benefit_kind]}
            type="select"
            label={gettext("Benefit kind")}
            options={[
              {gettext("Percentage discount"), "discount_percentage"},
              {gettext("Amount discount"), "discount_amount"},
              {gettext("Complimentary item"), "complimentary_item"},
              {gettext("Bundle"), "bundle"},
              {gettext("Custom"), "custom"}
            ]}
          />
          <.input field={@publish_form[:title]} type="text" label={gettext("Title")} />
          <div class="sm:col-span-2">
            <.input
              field={@publish_form[:description]}
              type="textarea"
              label={gettext("Description")}
            />
          </div>
          <div class="sm:col-span-2">
            <.input field={@publish_form[:terms]} type="textarea" label={gettext("Terms")} />
          </div>
          <div class="sm:col-span-2">
            <.input
              field={@publish_form[:redemption_instructions]}
              type="textarea"
              label={gettext("Redemption instructions")}
            />
          </div>
          <.input
            field={@publish_form[:percentage_value]}
            type="number"
            label={gettext("Percentage")}
            step="0.0001"
            min="0"
            max="100"
          />
          <.input
            field={@publish_form[:amount_value]}
            type="number"
            label={gettext("Amount")}
            step="0.01"
            min="0"
          />
          <.input
            field={@publish_form[:currency]}
            type="text"
            label={gettext("Currency")}
            maxlength="3"
          />
          <.input
            field={@publish_form[:effective_from]}
            type="datetime-local"
            label={gettext("Effective from")}
          />
          <.input
            field={@publish_form[:effective_until]}
            type="datetime-local"
            label={gettext("Effective until")}
          />
          <div class="flex items-end sm:col-span-2 sm:justify-end">
            <button
              id="publish-benefit-offer"
              type="submit"
              class="inline-flex h-11 items-center justify-center rounded-xl bg-blue-600 px-6 text-sm font-bold text-white shadow-[0_10px_24px_rgba(37,99,235,.2)] transition hover:bg-blue-700"
            >
              {gettext("Publish benefit")}
            </button>
          </div>
        </.form>
      </div>
    </section>

    <.form
      for={@filter_form}
      id="benefit-offer-filters"
      phx-submit="filter"
      class="mt-7 grid gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_8px_30px_rgba(15,23,42,.035)] sm:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)_auto_auto] sm:items-end"
    >
      <.input
        field={@filter_form[:status]}
        type="select"
        label={gettext("Status")}
        options={[
          {gettext("All statuses"), ""},
          {gettext("Draft"), "draft"},
          {gettext("Active"), "active"},
          {gettext("Retired"), "retired"}
        ]}
      />
      <.input field={@filter_form[:code]} type="text" label={gettext("Exact code")} />
      <button
        id="apply-benefit-filters"
        type="submit"
        class="inline-flex h-11 items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-bold text-white"
      >
        {gettext("Apply filters")}
      </button>
      <.link
        patch={~p"/admin/commercial/benefits?#{[polo: @current_polo.slug]}"}
        class="inline-flex h-11 items-center justify-center rounded-xl border border-slate-200 px-4 text-sm font-bold text-slate-600"
      >
        {gettext("Clear filters")}
      </.link>
    </.form>

    <section class="mt-7 overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-[0_8px_30px_rgba(15,23,42,.035)]">
      <div id="benefit-offers-inventory" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="benefit-offers-empty"
          class="hidden only:flex items-center gap-3 px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-ticket" class="size-5 text-slate-300" />
          {gettext("No benefits match this inventory.")}
        </div>

        <article
          :for={{id, offer} <- @streams.benefit_offers}
          id={id}
          data-offer-code={offer.code}
          class="grid gap-4 px-5 py-5 sm:px-6 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_auto] lg:items-center"
        >
          <div class="min-w-0">
            <h2 class="truncate text-sm font-black text-slate-950">{offer.name}</h2>
            <p class="mt-1 truncate text-xs text-slate-400">{offer.code}</p>
          </div>
          <div>
            <%= if offer.latest_version do %>
              <p data-version-status="published" class="text-sm font-bold text-slate-700">
                {offer.latest_version.title}
              </p>
              <p class="mt-1 text-xs text-slate-400">{benefit_value(offer.latest_version)}</p>
            <% else %>
              <p data-version-status="missing" class="text-sm font-bold text-slate-500">
                {gettext("No published version")}
              </p>
              <p class="mt-1 text-xs text-slate-400">
                {gettext("Complete publication to make this benefit selectable.")}
              </p>
            <% end %>
          </div>
          <span class="w-fit rounded-full bg-slate-100 px-3 py-1.5 text-[10px] font-bold uppercase tracking-wide text-slate-700 ring-1 ring-inset ring-slate-500/10">
            {status_label(offer.status)}
          </span>
        </article>
      </div>
    </section>

    <nav :if={@next_page_path} id="benefit-offers-pagination" class="mt-5 flex justify-end">
      <.link
        id="benefit-offers-next-page"
        patch={@next_page_path}
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-bold text-white"
      >
        {gettext("Next page")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </nav>
  </div>
</BackofficeComponents.shell>
