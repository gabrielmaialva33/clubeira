<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:moderation}
>
  <div id="moderation-reviews-page" class="mx-auto max-w-[1400px]">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
          {gettext("Trust and safety")}
        </p>
        <h1 class="clubeira-page-title mt-1.5">
          {gettext("Review moderation")}
        </h1>
        <p class="clubeira-page-copy mt-1.5">
          {gettext("Pending verified reviews waiting for a publish or reject decision.")}
        </p>
      </div>
      <div class="rounded-xl border border-clubeira-line bg-white px-4 py-3 text-sm">
        <span class="font-bold text-slate-950">{@page.limit}</span>
        <span class="ml-1 text-slate-500">{gettext("items per page")}</span>
      </div>
    </header>

    <nav id="moderation-tabs" class="mt-6 flex gap-2" aria-label={gettext("Moderation queues")}>
      <.link
        navigate={~p"/admin/moderation/reviews?#{[polo: @current_polo.slug]}"}
        aria-current="page"
        class="rounded-xl bg-clubeira-orange px-4 py-2.5 text-sm font-bold text-white"
      >
        {gettext("Pending reviews")}
      </.link>
      <.link
        navigate={~p"/admin/moderation/reports?#{[polo: @current_polo.slug]}"}
        class="rounded-xl border border-clubeira-line bg-white px-4 py-2.5 text-sm font-bold text-slate-600 transition hover:border-blue-200 hover:text-blue-700"
      >
        {gettext("Reports")}
      </.link>
    </nav>

    <section class="mt-7 overflow-hidden rounded-xl border border-clubeira-line bg-white">
      <div id="moderation-reviews" phx-update="stream" class="divide-y divide-slate-100">
        <div
          id="moderation-reviews-empty"
          class="hidden only:flex items-center gap-3 px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-check-badge" class="size-5 text-emerald-500" />
          {gettext("There are no reviews waiting for moderation.")}
        </div>

        <article
          :for={{id, review} <- @streams.reviews}
          id={id}
          class="grid gap-6 px-5 py-6 sm:px-6 xl:grid-cols-[minmax(0,1fr)_minmax(320px,0.62fr)] xl:items-start"
        >
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-700 ring-1 ring-inset ring-amber-600/10">
                {gettext("Pending")}
              </span>
              <span class="text-xs font-semibold text-slate-400">
                {ngettext("%{count} star", "%{count} stars", review.rating, count: review.rating)}
              </span>
            </div>
            <h2 class="mt-3 text-lg font-bold text-slate-950">
              {review.title || gettext("Untitled review")}
            </h2>
            <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600">{review.body}</p>
            <p class="mt-3 text-xs text-slate-400">
              {timestamp(review.submitted_at, @locale)}
            </p>
          </div>

          <% moderation_form = Map.fetch!(@moderation_forms, review.id) %>
          <.form
            for={moderation_form}
            id={"review-moderation-form-#{review.id}"}
            phx-submit="moderate_review"
            class="rounded-xl bg-slate-50 p-4 ring-1 ring-inset ring-slate-200"
          >
            <input type="hidden" name="review_id" value={review.id} />
            <.input
              field={moderation_form[:action]}
              type="select"
              label={gettext("Decision")}
              options={[
                {gettext("Select a decision"), ""},
                {gettext("Publish"), "publish"},
                {gettext("Reject"), "reject"}
              ]}
              required
            />
            <.input
              field={moderation_form[:reason]}
              type="textarea"
              label={gettext("Decision reason")}
              minlength="3"
              maxlength="500"
              required
            />
            <.input field={moderation_form[:idempotency_key]} type="hidden" />

            <button
              id={"review-moderation-submit-#{review.id}"}
              type="submit"
              phx-disable-with={gettext("Saving decision...")}
              class="inline-flex w-full items-center justify-center rounded-xl bg-clubeira-orange px-4 py-3 text-sm font-bold text-white transition hover:bg-orange-600 disabled:cursor-wait disabled:opacity-70"
            >
              {gettext("Save decision")}
            </button>
          </.form>
        </article>
      </div>
    </section>
  </div>
</BackofficeComponents.shell>
