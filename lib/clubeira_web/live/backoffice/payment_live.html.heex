<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:payments}
>
  <div id="payment-detail" class="mx-auto max-w-[1180px]">
    <.link
      id="back-to-finance"
      navigate={~p"/admin?#{[polo: @current_polo.slug]}" <> "#payments-section"}
      class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 transition hover:text-blue-700"
    >
      <.icon name="hero-arrow-left" class="size-4" />
      {gettext("Back to finance")}
    </.link>

    <header class="mt-6 flex flex-col gap-5 rounded-[26px] bg-[#0b2342] px-6 py-7 text-white shadow-[0_20px_60px_rgba(8,27,51,.14)] sm:px-8 lg:flex-row lg:items-end lg:justify-between">
      <div class="min-w-0">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-blue-200">
          {gettext("Financial operation")}
        </p>
        <h1
          id="payment-detail-amount"
          class="mt-2 text-3xl font-black tracking-[-0.045em] sm:text-4xl"
        >
          {money(@payment.amount, @payment.currency, @locale)}
        </h1>
        <p class="mt-2 break-all text-xs text-slate-400">{@payment.id}</p>
      </div>

      <span
        id="payment-detail-status"
        data-status={@payment.status}
        class="w-fit rounded-full bg-white/10 px-3 py-1.5 text-xs font-bold ring-1 ring-inset ring-white/10"
      >
        {status_label(@payment.status)}
      </span>
    </header>

    <section class="mt-7 grid gap-5 lg:grid-cols-2">
      <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Order")}
        </p>
        <h2 id="payment-detail-order" class="mt-3 break-all text-lg font-black text-slate-950">
          {@payment.order.order_number}
        </h2>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Order status")}</dt>
            <dd
              id="payment-detail-order-status"
              data-status={@payment.order.status}
              class="font-black text-slate-900"
            >
              {order_status_label(@payment.order.status)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Placed at")}</dt>
            <dd class="text-right text-slate-900">
              {timestamp(@payment.order.placed_at, @locale)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Purchaser ID")}</dt>
            <dd class="break-all text-right font-mono text-xs text-slate-700">
              {@payment.order.purchaser_user_id}
            </dd>
          </div>
        </dl>
      </article>

      <article class="min-w-0 rounded-2xl border border-slate-200 bg-white p-6 shadow-[0_8px_30px_rgba(15,23,42,.035)]">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Payment")}
        </p>
        <h2 class="mt-3 text-lg font-black capitalize text-slate-950">
          {humanized(@payment.provider_code)}
        </h2>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Payment method")}</dt>
            <dd class="font-black capitalize text-slate-900">
              {humanized(@payment.payment_method || gettext("Not available"))}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Captured at")}</dt>
            <dd class="text-right text-slate-900">
              {timestamp(@payment.captured_at, @locale)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Recorded at")}</dt>
            <dd class="text-right text-slate-900">
              {timestamp(@payment.recorded_at, @locale)}
            </dd>
          </div>
        </dl>
      </article>
    </section>

    <section class="mt-5 grid gap-5 lg:grid-cols-2">
      <article
        id="payment-refund-summary"
        class="rounded-2xl border border-slate-200 bg-white p-6"
      >
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-600">
          {gettext("Latest refund")}
        </p>
        <%= if @payment.refund do %>
          <p data-status={@payment.refund.status} class="mt-3 text-lg font-black text-slate-950">
            {status_label(@payment.refund.status)}
          </p>
          <p class="mt-2 text-sm text-slate-500">
            {money(@payment.refund.amount, @payment.currency, @locale)} · {timestamp(
              @payment.refund.requested_at,
              @locale
            )}
          </p>
        <% else %>
          <p class="mt-3 text-sm font-semibold text-slate-500">
            {gettext("No refund recorded.")}
          </p>
        <% end %>
      </article>

      <article
        id="payment-chargeback-summary"
        class="rounded-2xl border border-slate-200 bg-white p-6"
      >
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-600">
          {gettext("Latest chargeback")}
        </p>
        <%= if @payment.chargeback do %>
          <p
            data-status={@payment.chargeback.status}
            class="mt-3 text-lg font-black text-slate-950"
          >
            {humanized(@payment.chargeback.status)}
          </p>
          <p class="mt-2 text-sm text-slate-500">
            {money(@payment.chargeback.amount, @payment.currency, @locale)} · {timestamp(
              @payment.chargeback.opened_at,
              @locale
            )}
          </p>
        <% else %>
          <p class="mt-3 text-sm font-semibold text-slate-500">
            {gettext("No chargeback recorded.")}
          </p>
        <% end %>
      </article>
    </section>
  </div>
</BackofficeComponents.shell>
