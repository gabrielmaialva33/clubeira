<BackofficeComponents.shell
  account_scope={@current_account_scope}
  access={@backoffice_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:payments}
>
  <div id="payment-detail" class="mx-auto max-w-[1180px]">
    <.link
      id="back-to-finance"
      navigate={~p"/admin/payments?#{[polo: @current_polo.slug]}"}
      class="inline-flex items-center gap-2 text-sm font-bold text-slate-500 transition hover:text-blue-700"
    >
      <.icon name="hero-arrow-left" class="size-4" />
      {gettext("Back to finance")}
    </.link>

    <header class="clubeira-ticket-rail clubeira-grid-paper mt-5 flex flex-col gap-5 rounded-xl border border-clubeira-line bg-white px-6 py-6 sm:px-7 lg:flex-row lg:items-center lg:justify-between">
      <div class="min-w-0">
        <p class="clubeira-page-kicker">
          {gettext("Financial operation")}
        </p>
        <h1
          id="payment-detail-amount"
          class="clubeira-page-title mt-1.5"
        >
          {money(@payment.amount, @payment.currency, @locale)}
        </h1>
        <p class="mt-2 break-all text-xs text-clubeira-muted">{@payment.id}</p>
      </div>

      <span
        id="payment-detail-status"
        data-status={@payment.status}
        class="w-fit rounded-lg bg-clubeira-blue-soft px-3 py-1.5 text-xs font-bold text-clubeira-blue"
      >
        {status_label(@payment.status)}
      </span>
    </header>

    <section class="mt-7 grid gap-5 lg:grid-cols-2">
      <article class="min-w-0 rounded-xl border border-clubeira-line bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Order")}
        </p>
        <h2 id="payment-detail-order" class="mt-3 break-all text-lg font-bold text-slate-950">
          {@payment.order.order_number}
        </h2>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Order status")}</dt>
            <dd
              id="payment-detail-order-status"
              data-status={@payment.order.status}
              class="font-bold text-slate-900"
            >
              {order_status_label(@payment.order.status)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Placed at")}</dt>
            <dd id="payment-detail-placed-at" class="text-right text-slate-900">
              {timestamp(@payment.order.placed_at, @locale)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Purchaser ID")}</dt>
            <dd class="break-all text-right font-mono text-xs text-slate-700">
              {@payment.order.purchaser_user_id}
            </dd>
          </div>
        </dl>
      </article>

      <article class="min-w-0 rounded-xl border border-clubeira-line bg-white p-6">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-slate-400">
          {gettext("Payment")}
        </p>
        <h2 class="mt-3 text-lg font-bold capitalize text-slate-950">
          {humanized(@payment.provider_code)}
        </h2>
        <dl class="mt-5 space-y-3 text-sm">
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Payment method")}</dt>
            <dd class="font-bold capitalize text-slate-900">
              {humanized(@payment.payment_method || gettext("Not available"))}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Captured at")}</dt>
            <dd id="payment-detail-captured-at" class="text-right text-slate-900">
              {timestamp(@payment.captured_at, @locale)}
            </dd>
          </div>
          <div class="flex items-center justify-between gap-4">
            <dt class="font-bold text-slate-500">{gettext("Recorded at")}</dt>
            <dd id="payment-detail-recorded-at" class="text-right text-slate-900">
              {timestamp(@payment.recorded_at, @locale)}
            </dd>
          </div>
        </dl>
      </article>
    </section>

    <section class="mt-5 grid gap-5 lg:grid-cols-2">
      <article
        id="payment-refund-summary"
        class="rounded-xl border border-clubeira-line bg-white p-6"
      >
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-600">
          {gettext("Latest refund")}
        </p>
        <%= if @payment.refund do %>
          <p data-status={@payment.refund.status} class="mt-3 text-lg font-bold text-slate-950">
            {status_label(@payment.refund.status)}
          </p>
          <p class="mt-2 text-sm text-slate-500">
            {money(@payment.refund.amount, @payment.currency, @locale)} · {timestamp(
              @payment.refund.requested_at,
              @locale
            )}
          </p>
        <% else %>
          <p class="mt-3 text-sm font-semibold text-slate-500">
            {gettext("No refund recorded.")}
          </p>
        <% end %>
      </article>

      <article
        id="payment-chargeback-summary"
        class="rounded-xl border border-clubeira-line bg-white p-6"
      >
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-red-600">
          {gettext("Latest chargeback")}
        </p>
        <%= if @payment.chargeback do %>
          <p
            data-status={@payment.chargeback.status}
            class="mt-3 text-lg font-bold text-slate-950"
          >
            {humanized(@payment.chargeback.status)}
          </p>
          <p class="mt-2 text-sm text-slate-500">
            {money(@payment.chargeback.amount, @payment.currency, @locale)} · {timestamp(
              @payment.chargeback.opened_at,
              @locale
            )}
          </p>
        <% else %>
          <p class="mt-3 text-sm font-semibold text-slate-500">
            {gettext("No chargeback recorded.")}
          </p>
        <% end %>
      </article>
    </section>

    <section class="mt-5 rounded-xl border border-clubeira-line bg-white p-6 sm:p-8">
      <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.72fr)] lg:items-start">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-orange-600">
            {gettext("Financial operation")}
          </p>
          <h2 class="mt-2 text-2xl font-bold tracking-[-0.035em] text-slate-950">
            {gettext("Full payment refund")}
          </h2>
          <p class="mt-3 max-w-xl text-sm leading-6 text-slate-500">
            {gettext(
              "The amount is derived from the captured payment. Authorization, reservation, provider confirmation and settlement remain idempotent and auditable."
            )}
          </p>
        </div>

        <%= if @refund_form do %>
          <.form
            for={@refund_form}
            id={"payment-refund-form-#{@refund_form[:idempotency_key].value}"}
            phx-submit="refund_payment"
            class="rounded-xl bg-slate-50 p-4 ring-1 ring-inset ring-slate-200"
          >
            <div id="payment-refund-reason-field">
              <.input
                field={@refund_form[:reason]}
                id={"payment-refund-reason-#{@refund_form[:idempotency_key].value}"}
                type="textarea"
                label={gettext("Refund reason")}
                minlength="3"
                maxlength="500"
                required
              />
            </div>
            <.input field={@refund_form[:idempotency_key]} type="hidden" />

            <button
              id="payment-refund-submit"
              type="submit"
              phx-disable-with={gettext("Refunding...")}
              class="inline-flex w-full items-center justify-center rounded-xl bg-orange-500 px-4 py-3 text-sm font-bold text-white transition hover:bg-orange-600 disabled:cursor-wait disabled:opacity-70"
            >
              {gettext("Refund full payment")}
            </button>
          </.form>
        <% else %>
          <div
            id="payment-refund-unavailable"
            class="rounded-xl bg-slate-100 px-4 py-4 text-sm font-semibold text-slate-600"
          >
            {gettext("This payment has no refund action available.")}
          </div>
        <% end %>
      </div>
    </section>
  </div>
</BackofficeComponents.shell>
