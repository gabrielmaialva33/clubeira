<PartnerComponents.shell
  account_scope={@current_account_scope}
  access={@partner_access}
  current_polo={@current_polo}
  polo_form={@polo_form}
  flash={@flash}
  active_section={:reviews}
>
  <div id="partner-reviews-page" class="mx-auto max-w-[1320px]">
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
          {gettext("Member feedback")}
        </p>
        <h1 class="clubeira-page-title mt-1.5">
          {gettext("Review inbox")}
        </h1>
        <p class="clubeira-page-copy mt-1.5">
          {gettext("Read verified member feedback and publish your organization's response.")}
        </p>
      </div>
      <.link
        id="partner-reviews-places-link"
        navigate={"/partner?#{URI.encode_query(%{"polo" => @current_polo.slug})}"}
        class="inline-flex h-11 items-center gap-2 rounded-xl border border-blue-200 bg-blue-50 px-4 text-sm font-bold text-blue-700 transition hover:bg-blue-100"
      >
        <.icon name="hero-building-storefront" class="size-5" />
        {gettext("My places")}
      </.link>
    </header>

    <.form
      for={@filter_form}
      id="partner-review-filters"
      phx-change="filter"
      class="mt-7 max-w-xl rounded-xl border border-clubeira-line bg-white p-4"
    >
      <.input
        field={@filter_form[:place_id]}
        type="select"
        label={gettext("Place")}
        options={[{gettext("All assigned places"), ""} | @place_options]}
      />
    </.form>

    <section class="mt-6">
      <div id="partner-reviews" phx-update="stream" class="space-y-4">
        <div
          id="partner-reviews-empty"
          class="hidden only:flex items-center gap-3 rounded-xl border border-clubeira-line bg-white px-6 py-12 text-sm text-slate-500"
        >
          <.icon name="hero-chat-bubble-left-right" class="size-5 text-slate-300" />
          {gettext("No published reviews were found for this selection.")}
        </div>

        <article
          :for={{id, review} <- @streams.reviews}
          id={id}
          class="rounded-xl border border-clubeira-line bg-white p-5 sm:p-6"
        >
          <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
            <div class="min-w-0">
              <p class="text-xs font-bold uppercase tracking-[0.15em] text-blue-600">
                {review.place.name}
              </p>
              <div
                id={"partner-review-rating-#{review.id}"}
                data-rating={review.rating}
                class="mt-2 flex gap-0.5"
                aria-label={
                  ngettext("%{count} star", "%{count} stars", review.rating, count: review.rating)
                }
              >
                <span
                  :for={star <- 1..5}
                  class={[
                    "text-lg",
                    star <= review.rating && "text-orange-500",
                    star > review.rating && "text-slate-200"
                  ]}
                >
                  ★
                </span>
              </div>
              <h2 :if={review.title} class="mt-3 text-base font-bold text-slate-950">
                {review.title}
              </h2>
              <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-600">
                {review.body}
              </p>
            </div>

            <button
              id={"partner-respond-review-#{review.id}"}
              type="button"
              phx-click="edit_response"
              phx-value-review_id={review.id}
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-clubeira-orange px-4 py-2.5 text-xs font-bold text-white transition hover:bg-orange-600"
            >
              <.icon name="hero-pencil-square" class="size-4" />
              <%= if review.response do %>
                {gettext("Edit response")}
              <% else %>
                {gettext("Respond")}
              <% end %>
            </button>
          </div>

          <div
            :if={review.response}
            id={"partner-review-response-#{review.id}"}
            class="mt-5 rounded-xl border border-blue-100 bg-blue-50/70 p-4"
          >
            <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-blue-700">
              {gettext("Your published response")}
            </p>
            <p class="mt-2 whitespace-pre-line text-sm leading-6 text-slate-700">
              {review.response.body}
            </p>
            <p class="mt-2 text-[11px] font-semibold text-slate-400">
              {gettext("Revision %{revision}", revision: review.response.revision_number)}
            </p>
          </div>
        </article>
      </div>
    </section>

    <nav
      :if={@next_page_path}
      id="partner-reviews-pagination"
      class="mt-5 flex items-center justify-end"
      aria-label={gettext("Review pagination")}
    >
      <.link
        id="partner-reviews-next-page"
        patch={@next_page_path}
        class="inline-flex h-11 items-center gap-2 rounded-xl bg-clubeira-orange px-5 text-sm font-bold text-white transition hover:bg-orange-600"
      >
        {gettext("Next page")}
        <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </nav>

    <section
      :if={@selected_review}
      id="partner-response-editor"
      class="fixed inset-x-4 bottom-4 z-30 mx-auto max-w-2xl rounded-xl border border-clubeira-line border-t-4 border-t-clubeira-orange bg-white p-5 shadow-[0_18px_48px_rgba(16,33,61,.16)] sm:p-6"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-orange-600">
            {@selected_review.place.name}
          </p>
          <h2 class="mt-1 text-xl font-bold text-slate-950">{gettext("Public response")}</h2>
        </div>
        <button
          id="partner-response-cancel"
          type="button"
          phx-click="cancel_response"
          class="grid size-9 place-items-center rounded-xl text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
          aria-label={gettext("Close response editor")}
        >
          <.icon name="hero-x-mark" class="size-5" />
        </button>
      </div>

      <.form
        for={@response_form}
        id="partner-response-form"
        phx-change="validate_response"
        phx-submit="save_response"
        class="mt-5"
      >
        <.input
          field={@response_form[:body]}
          type="textarea"
          label={gettext("Response")}
          minlength="2"
          maxlength="5000"
          required
        />
        <.input field={@response_form[:idempotency_key]} type="hidden" />

        <div class="mt-4 flex justify-end">
          <button
            id="partner-response-submit"
            type="submit"
            phx-disable-with={gettext("Publishing response...")}
            class="inline-flex w-full items-center justify-center rounded-xl bg-orange-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-orange-600 disabled:cursor-wait disabled:opacity-70 sm:w-auto"
          >
            {gettext("Publish response")}
          </button>
        </div>
      </.form>
    </section>
  </div>
</PartnerComponents.shell>
