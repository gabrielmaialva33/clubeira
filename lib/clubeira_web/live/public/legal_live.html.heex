<div id="public-legal" class="flex min-h-screen flex-col bg-clubeira-canvas text-clubeira-ink">
  <PublicComponents.header
    navigate={~p"/explorar"}
    title="Clubeira"
    subtitle={gettext("Transparency")}
  />

  <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <Layouts.flash_group id="public-legal-flash" flash={@flash} />

    <section class="max-w-3xl">
      <p class="clubeira-page-kicker">
        {gettext("Transparency")}
      </p>
      <h1 class="mt-2 text-3xl font-bold tracking-[-0.05em] text-clubeira-ink sm:text-4xl">
        {gettext("Clubeira terms")}
      </h1>
      <p class="mt-3 text-sm leading-6 text-clubeira-muted sm:text-base">
        {gettext("Read the current documents applicable to consumer registration.")}
      </p>
    </section>

    <section
      id="public-legal-documents"
      phx-update="stream"
      class="mt-7 grid gap-3 sm:grid-cols-2"
    >
      <div
        id="public-legal-documents-empty"
        class="hidden only:block rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 sm:col-span-2"
      >
        {gettext("No current legal document is available for this locale.")}
      </div>
      <article
        :for={{id, document} <- @streams.documents}
        id={id}
        data-document-kind={document.document_kind}
        class="rounded-xl border border-clubeira-line bg-white p-5"
      >
        <span class="clubeira-icon-tile">
          <.icon name="hero-document-text" class="size-5" />
        </span>
        <h2 class="mt-5 text-xl font-bold tracking-[-0.03em]">{document_label(document)}</h2>
        <p class="mt-2 text-sm text-slate-500">
          {gettext("Version %{version} · %{locale}",
            version: document.version,
            locale: document.locale
          )}
        </p>
        <a
          :if={document.public_uri}
          href={document.public_uri}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-blue-700"
        >
          {gettext("Open document")}
          <.icon name="hero-arrow-top-right-on-square" class="size-4" />
        </a>
        <p :if={!document.public_uri} class="mt-6 text-sm font-bold text-orange-700">
          {gettext("Document link unavailable")}
        </p>
      </article>
    </section>
  </main>
  <PublicComponents.footer />
</div>
