<div id="public-place-detail" class="min-h-screen bg-[#f4f7fb] text-slate-950">
  <header class="border-b border-slate-200 bg-white/90 backdrop-blur">
    <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <.link navigate={~p"/explorar/#{@polo.slug}"} class="flex items-center gap-3">
        <span class="grid size-11 place-items-center rounded-2xl bg-[#0b2342] text-white shadow-lg">
          <.icon name="hero-arrow-left" class="size-5" />
        </span>
        <span>
          <span class="block text-lg font-black tracking-[-0.04em]">{@polo.name}</span>
          <span class="block text-[9px] font-bold uppercase tracking-[0.24em] text-orange-600">
            {gettext("Back to the catalog")}
          </span>
        </span>
      </.link>
      <.link
        navigate={~p"/app/login"}
        class="rounded-xl bg-blue-600 px-4 py-2.5 text-sm font-black text-white shadow-sm hover:bg-blue-700"
      >
        {gettext("Sign in")}
      </.link>
    </div>
  </header>

  <main class="mx-auto max-w-7xl px-4 py-9 sm:px-6 sm:py-12 lg:px-8">
    <Layouts.flash_group id="public-place-flash" flash={@flash} />

    <section class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,.65fr)]">
      <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_16px_55px_rgba(15,23,42,.06)]">
        <div class="h-3 bg-gradient-to-r from-blue-600 via-blue-500 to-orange-500" />
        <div class="p-6 sm:p-9">
          <p class="text-xs font-black uppercase tracking-[0.18em] text-orange-600">
            {@place.address.city.name} · {@place.address.city.subdivision_code}
          </p>
          <h1 class="mt-3 text-4xl font-black tracking-[-0.055em] sm:text-5xl">{@place.name}</h1>

          <div class="mt-5 flex flex-wrap gap-2">
            <span
              :for={category <- profile_categories(@place)}
              class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-black text-blue-700"
            >
              {category["name"]}
            </span>
            <span
              :for={brand <- @place.brands}
              class="rounded-full bg-orange-50 px-3 py-1.5 text-xs font-black text-orange-700"
            >
              {brand.name}
            </span>
          </div>

          <div class="mt-8 grid gap-5 border-t border-slate-100 pt-7 sm:grid-cols-2">
            <div>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400">
                {gettext("Address")}
              </p>
              <p class="mt-2 text-sm font-bold leading-6 text-slate-700">
                {@place.address.street}, {@place.address.number || gettext("no number")}<br />
                {@place.address.district} · {@place.address.city.name}
              </p>
            </div>
            <div :if={profile_contact(@place, "email") || profile_contact(@place, "phone")}>
              <p class="text-xs font-black uppercase tracking-wider text-slate-400">
                {gettext("Contact")}
              </p>
              <a
                :if={profile_contact(@place, "email")}
                href={"mailto:#{profile_contact(@place, "email")}"}
                class="mt-2 block break-all text-sm font-bold text-blue-700"
              >
                {profile_contact(@place, "email")}
              </a>
              <a
                :if={profile_contact(@place, "phone")}
                href={"tel:#{profile_contact(@place, "phone")}"}
                class="mt-1 block text-sm font-bold text-blue-700"
              >
                {profile_contact(@place, "phone")}
              </a>
            </div>
          </div>
        </div>
      </article>

      <aside class="rounded-[2rem] bg-[#0b2342] p-6 text-white shadow-2xl sm:p-8">
        <p class="text-xs font-black uppercase tracking-[0.18em] text-orange-400">
          {gettext("Opening hours")}
        </p>
        <div id="public-place-hours" class="mt-5 space-y-3">
          <p :if={weekly_hours(@place) == []} class="text-sm leading-6 text-blue-100">
            {gettext("Published opening hours are not available.")}
          </p>
          <div
            :for={period <- weekly_hours(@place)}
            class="flex items-center justify-between gap-4 border-b border-white/10 pb-3 text-sm"
          >
            <span class="font-bold">{weekday_name(period["weekday"])}</span>
            <span class="text-blue-100">
              {period["opens_at"]}–{period["closes_at"]}
              <span :if={period["closes_next_day"]}> +1</span>
            </span>
          </div>
        </div>
        <.link
          id="public-place-legal-link"
          navigate={~p"/termos"}
          class="mt-7 inline-flex items-center gap-2 text-sm font-black text-orange-300 hover:text-orange-200"
        >
          {gettext("Read Clubeira terms")} <.icon name="hero-arrow-right" class="size-4" />
        </.link>
      </aside>
    </section>

    <section class="mt-12">
      <p class="text-xs font-black uppercase tracking-[0.18em] text-blue-600">
        {gettext("Verified experiences")}
      </p>
      <h2 class="mt-2 text-2xl font-black tracking-[-0.04em]">{gettext("Reviews")}</h2>

      <div
        id="public-place-reviews"
        phx-update="stream"
        class="mt-5 grid gap-4 lg:grid-cols-2"
      >
        <div
          id="public-place-reviews-empty"
          class="hidden only:block rounded-3xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 lg:col-span-2"
        >
          {gettext("This place has no published reviews yet.")}
        </div>
        <article
          :for={{id, review} <- @streams.reviews}
          id={id}
          data-rating={review.rating}
          class="rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_12px_42px_rgba(15,23,42,.05)]"
        >
          <div class="flex items-center justify-between gap-4">
            <span
              class="text-lg tracking-wider text-orange-500"
              aria-label={gettext("%{rating} out of 5", rating: review.rating)}
            >
              {String.duplicate("★", review.rating)}
            </span>
            <time
              class="text-xs font-bold text-slate-400"
              datetime={DateTime.to_iso8601(review.published_at)}
            >
              {Calendar.strftime(review.published_at, "%d/%m/%Y")}
            </time>
          </div>
          <h3 :if={review.title} class="mt-4 text-lg font-black">{review.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{review.body}</p>
          <div
            :if={review.response}
            class="mt-5 rounded-2xl border-l-4 border-blue-500 bg-blue-50 p-4"
          >
            <p class="text-xs font-black uppercase tracking-wider text-blue-700">
              {gettext("Response from %{organization}",
                organization: review.response.organization.name
              )}
            </p>
            <p class="mt-2 text-sm leading-6 text-blue-950">{review.response.body}</p>
          </div>
          <.link
            id={"public-report-review-#{review.public_key}"}
            navigate={~p"/app/login"}
            class="mt-5 inline-flex h-10 items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 text-xs font-black text-slate-600 hover:border-orange-200 hover:text-orange-700"
          >
            <.icon name="hero-flag" class="size-4" /> {gettext("Report review")}
          </.link>
        </article>
      </div>

      <.link
        :if={@reviews_next_page_path}
        id="public-reviews-next-page"
        patch={@reviews_next_page_path}
        class="mt-6 inline-flex h-11 items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 text-sm font-bold text-slate-700 shadow-sm"
      >
        {gettext("More reviews")} <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </section>
  </main>
</div>
