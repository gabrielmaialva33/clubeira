<div
  id="public-place-detail"
  class="flex min-h-screen flex-col bg-clubeira-canvas text-clubeira-ink"
>
  <PublicComponents.header
    navigate={~p"/explorar/#{@polo.slug}"}
    title={@polo.name}
    subtitle={gettext("Back to the catalog")}
    back?
  />

  <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <Layouts.flash_group id="public-place-flash" flash={@flash} />

    <section class="grid gap-6 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,.65fr)]">
      <article class="overflow-hidden rounded-xl border border-clubeira-line bg-white">
        <div class="h-1 bg-clubeira-orange" />
        <div class="clubeira-grid-paper p-6 sm:p-8">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
            {@place.address.city.name} · {@place.address.city.subdivision_code}
          </p>
          <h1 class="mt-3 text-3xl font-bold tracking-[-0.05em] text-clubeira-ink sm:text-4xl">
            {@place.name}
          </h1>

          <div class="mt-5 flex flex-wrap gap-2">
            <span
              :for={category <- profile_categories(@place)}
              class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-bold text-blue-700"
            >
              {category["name"]}
            </span>
            <span
              :for={brand <- @place.brands}
              class="rounded-full bg-orange-50 px-3 py-1.5 text-xs font-bold text-orange-700"
            >
              {brand.name}
            </span>
          </div>

          <div class="mt-8 grid gap-5 border-t border-slate-100 pt-7 sm:grid-cols-2">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                {gettext("Address")}
              </p>
              <p class="mt-2 text-sm font-bold leading-6 text-slate-700">
                {@place.address.street}, {@place.address.number || gettext("no number")}<br />
                {@place.address.district} · {@place.address.city.name}
              </p>
            </div>
            <div :if={profile_contact(@place, "email") || profile_contact(@place, "phone")}>
              <p class="text-xs font-bold uppercase tracking-wider text-slate-400">
                {gettext("Contact")}
              </p>
              <a
                :if={profile_contact(@place, "email")}
                href={"mailto:#{profile_contact(@place, "email")}"}
                class="mt-2 block break-all text-sm font-bold text-blue-700"
              >
                {profile_contact(@place, "email")}
              </a>
              <a
                :if={profile_contact(@place, "phone")}
                href={"tel:#{profile_contact(@place, "phone")}"}
                class="mt-1 block text-sm font-bold text-blue-700"
              >
                {profile_contact(@place, "phone")}
              </a>
            </div>
          </div>
        </div>
      </article>

      <aside class="rounded-xl border border-orange-200 bg-clubeira-orange-soft/65 p-6 text-clubeira-ink sm:p-7">
        <div class="flex items-center gap-3">
          <span class="grid size-10 place-items-center rounded-lg bg-white text-clubeira-orange ring-1 ring-orange-200">
            <.icon name="hero-clock" class="size-5" />
          </span>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-clubeira-orange">
            {gettext("Opening hours")}
          </p>
        </div>
        <div id="public-place-hours" class="mt-5 space-y-3">
          <p :if={weekly_hours(@place) == []} class="text-sm leading-6 text-clubeira-muted">
            {gettext("Published opening hours are not available.")}
          </p>
          <div
            :for={period <- weekly_hours(@place)}
            class="flex items-center justify-between gap-4 border-b border-orange-200/70 pb-3 text-sm"
          >
            <span class="font-bold">{weekday_name(period["weekday"])}</span>
            <span class="text-orange-900">
              {period["opens_at"]}–{period["closes_at"]}
              <span :if={period["closes_next_day"]}> +1</span>
            </span>
          </div>
        </div>
        <.link
          id="public-place-legal-link"
          navigate={~p"/termos"}
          class="mt-7 inline-flex items-center gap-2 text-sm font-bold text-clubeira-orange hover:text-orange-700"
        >
          {gettext("Read Clubeira terms")} <.icon name="hero-arrow-right" class="size-4" />
        </.link>
      </aside>
    </section>

    <section class="mt-12">
      <p class="clubeira-page-kicker">
        {gettext("Verified experiences")}
      </p>
      <h2 class="mt-2 text-2xl font-bold tracking-[-0.04em]">{gettext("Reviews")}</h2>

      <div
        id="public-place-reviews"
        phx-update="stream"
        class="mt-5 grid gap-4 lg:grid-cols-2"
      >
        <div
          id="public-place-reviews-empty"
          class="hidden only:block rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 lg:col-span-2"
        >
          {gettext("This place has no published reviews yet.")}
        </div>
        <article
          :for={{id, review} <- @streams.reviews}
          id={id}
          data-rating={review.rating}
          class="rounded-xl border border-clubeira-line bg-white p-5"
        >
          <div class="flex items-center justify-between gap-4">
            <span
              class="text-lg tracking-wider text-orange-500"
              aria-label={gettext("%{rating} out of 5", rating: review.rating)}
            >
              {String.duplicate("★", review.rating)}
            </span>
            <time
              class="text-xs font-bold text-slate-400"
              datetime={DateTime.to_iso8601(review.published_at)}
            >
              {Calendar.strftime(review.published_at, "%d/%m/%Y")}
            </time>
          </div>
          <h3 :if={review.title} class="mt-4 text-lg font-bold">{review.title}</h3>
          <p class="mt-3 text-sm leading-6 text-slate-600">{review.body}</p>
          <div
            :if={review.response}
            class="mt-5 rounded-lg border-l-2 border-clubeira-blue bg-clubeira-blue-soft p-4"
          >
            <p class="text-xs font-bold uppercase tracking-wider text-blue-700">
              {gettext("Response from %{organization}",
                organization: review.response.organization.name
              )}
            </p>
            <p class="mt-2 text-sm leading-6 text-blue-950">{review.response.body}</p>
          </div>
          <.link
            id={"public-report-review-#{review.public_key}"}
            navigate={~p"/app/login"}
            class="mt-5 inline-flex h-9 items-center gap-2 rounded-lg border border-clubeira-line bg-white px-3 text-xs font-bold text-clubeira-muted hover:border-orange-200 hover:text-clubeira-orange"
          >
            <.icon name="hero-flag" class="size-4" /> {gettext("Report review")}
          </.link>
        </article>
      </div>

      <.link
        :if={@reviews_next_page_path}
        id="public-reviews-next-page"
        patch={@reviews_next_page_path}
        class="clubeira-button-secondary mt-6"
      >
        {gettext("More reviews")} <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </section>
  </main>
  <PublicComponents.footer />
</div>
