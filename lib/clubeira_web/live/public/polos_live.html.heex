<div id="public-polos" class="flex min-h-screen flex-col bg-clubeira-canvas text-clubeira-ink">
  <PublicComponents.header
    navigate={~p"/explorar"}
    title="Clubeira"
    subtitle={gettext("Benefits near you")}
  />

  <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <Layouts.flash_group id="public-polos-flash" flash={@flash} />

    <section class="clubeira-ticket-rail clubeira-grid-paper overflow-hidden rounded-xl border border-clubeira-line bg-white">
      <div class="grid md:grid-cols-[minmax(0,1.35fr)_minmax(260px,0.65fr)]">
        <div class="px-6 py-8 sm:px-9 sm:py-10">
          <p class="clubeira-page-kicker">{gettext("Choose your region")}</p>
          <h1 class="mt-3 max-w-2xl text-3xl font-bold tracking-[-0.05em] text-clubeira-ink sm:text-4xl">
            {gettext("Discover your Clubeira")}
          </h1>
          <p class="mt-4 max-w-2xl text-sm leading-6 text-clubeira-muted sm:text-base">
            {gettext("Find active local clubs and explore benefits from their partner network.")}
          </p>
        </div>
        <div class="hidden items-center justify-center border-l border-clubeira-line bg-clubeira-blue-soft/65 p-8 md:flex">
          <div class="text-center">
            <span class="mx-auto grid size-16 place-items-center rounded-xl bg-white text-clubeira-blue ring-1 ring-clubeira-line">
              <.icon name="hero-map-pin" class="size-8" />
            </span>
            <p class="mt-4 text-sm font-bold text-clubeira-ink">{gettext("Benefits near you")}</p>
            <p class="mt-1 text-xs text-clubeira-muted">
              {gettext("Local benefits and trusted partners")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <section
      :if={@load_error?}
      id="public-polos-load-error"
      class="mt-6 flex items-center justify-between gap-5 rounded-xl border border-orange-200 bg-clubeira-orange-soft p-5 text-orange-950"
    >
      <p class="text-sm font-bold">{gettext("Public discovery is temporarily unavailable.")}</p>
      <.link
        id="public-polos-retry"
        navigate={~p"/explorar"}
        class="clubeira-button-primary shrink-0"
      >
        <.icon name="hero-arrow-path" class="size-4" /> {gettext("Explore Clubeira")}
      </.link>
    </section>

    <section
      :if={!@load_error?}
      id="public-polos-stream"
      phx-update="stream"
      class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3"
    >
      <div
        id="public-polos-empty"
        class="hidden only:block rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 sm:col-span-2 xl:col-span-3"
      >
        {gettext("No active polo is available right now.")}
      </div>
      <article
        :for={{id, polo} <- @streams.polos}
        id={id}
        class="clubeira-ticket-rail group rounded-xl border border-clubeira-line bg-white p-5 transition hover:border-blue-200"
      >
        <div class="flex items-start gap-4">
          <span class="clubeira-icon-tile shrink-0"><.icon name="hero-map" class="size-5" /></span>
          <div class="min-w-0 flex-1">
            <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-clubeira-orange">
              {polo.city.name} · {polo.city.subdivision_code}
            </p>
            <h2 class="mt-2 truncate text-lg font-bold tracking-[-0.03em] text-clubeira-ink">
              {polo.name}
            </h2>
            <p class="mt-1 text-xs leading-5 text-clubeira-muted">
              {gettext("Local benefits and trusted partners")}
            </p>
            <.link
              navigate={~p"/explorar/#{polo.slug}"}
              class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-clubeira-blue group-hover:text-blue-800"
            >
              {gettext("Explore this polo")} <.icon name="hero-arrow-right" class="size-4" />
            </.link>
          </div>
        </div>
      </article>
    </section>

    <.link
      :if={@next_page_path}
      id="public-polos-next-page"
      patch={@next_page_path}
      class="clubeira-button-secondary mt-6"
    >
      {gettext("More polos")} <.icon name="hero-arrow-right" class="size-4" />
    </.link>
  </main>
  <PublicComponents.footer />
</div>
