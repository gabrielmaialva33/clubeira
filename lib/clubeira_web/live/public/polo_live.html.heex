<div id="public-polo" class="flex min-h-screen flex-col bg-clubeira-canvas text-clubeira-ink">
  <PublicComponents.header
    navigate={~p"/explorar"}
    title="Clubeira"
    subtitle={@polo.name}
    show_terms?
  />

  <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-8 sm:px-6 sm:py-10 lg:px-8">
    <Layouts.flash_group id="public-polo-flash" flash={@flash} />

    <section class="clubeira-ticket-rail clubeira-grid-paper rounded-xl border border-clubeira-line bg-white px-6 py-8 sm:px-9 sm:py-10">
      <p class="clubeira-page-kicker">
        {gettext("Local Clubeira")}
      </p>
      <h1 class="mt-3 text-3xl font-bold tracking-[-0.05em] text-clubeira-ink sm:text-4xl">
        {@polo.name}
      </h1>
      <p class="mt-3 max-w-2xl text-sm leading-6 text-clubeira-muted sm:text-base">
        {gettext("Browse current benefits and the establishments where you can enjoy them.")}
      </p>
    </section>

    <nav
      id="public-polo-filters"
      class="mt-5 inline-flex max-w-full gap-1 overflow-x-auto rounded-xl border border-clubeira-line bg-white p-1"
      aria-label={gettext("Catalog sections")}
    >
      <.link
        id="public-polo-filter-all"
        patch={~p"/explorar/#{@polo.slug}"}
        aria-current={@section == "all" && "page"}
        class={[
          "shrink-0 rounded-lg px-4 py-2 text-xs font-bold transition",
          @section == "all" && "bg-clubeira-blue-soft text-clubeira-blue",
          @section != "all" && "text-clubeira-muted hover:bg-clubeira-canvas"
        ]}
      >
        {gettext("All")}
      </.link>
      <.link
        id="public-polo-filter-benefits"
        patch={~p"/explorar/#{@polo.slug}?section=benefits"}
        aria-current={@section == "benefits" && "page"}
        class={[
          "shrink-0 rounded-lg px-4 py-2 text-xs font-bold transition",
          @section == "benefits" && "bg-clubeira-blue-soft text-clubeira-blue",
          @section != "benefits" && "text-clubeira-muted hover:bg-clubeira-canvas"
        ]}
      >
        {gettext("Benefits")}
      </.link>
      <.link
        id="public-polo-filter-places"
        patch={~p"/explorar/#{@polo.slug}?section=places"}
        aria-current={@section == "places" && "page"}
        class={[
          "shrink-0 rounded-lg px-4 py-2 text-xs font-bold transition",
          @section == "places" && "bg-clubeira-blue-soft text-clubeira-blue",
          @section != "places" && "text-clubeira-muted hover:bg-clubeira-canvas"
        ]}
      >
        {gettext("Places")}
      </.link>
    </nav>

    <section :if={@section in ["all", "benefits"]} id="public-benefits" class="mt-9">
      <div>
        <p class="clubeira-page-kicker">
          {gettext("Current catalog")}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-[-0.04em]">{gettext("Benefits")}</h2>
      </div>
      <div
        id="public-benefits-stream"
        phx-update="stream"
        class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3"
      >
        <div
          id="public-benefits-empty"
          class="hidden only:block rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 sm:col-span-2 xl:col-span-3"
        >
          {gettext("No published benefit is available right now.")}
        </div>
        <article
          :for={{id, offer} <- @streams.offers}
          id={id}
          class="clubeira-ticket-rail rounded-xl border border-clubeira-line bg-white p-5"
        >
          <div>
            <p class="inline-flex rounded-md bg-clubeira-orange-soft px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-clubeira-orange">
              {benefit_value(offer)}
            </p>
            <h3 class="mt-4 text-lg font-bold tracking-[-0.03em] text-clubeira-ink">
              {offer.title}
            </h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{offer.description}</p>
            <details class="mt-5 rounded-lg bg-clubeira-canvas p-4">
              <summary class="cursor-pointer text-sm font-bold text-blue-700">
                {gettext("How to use and terms")}
              </summary>
              <p class="mt-3 text-xs leading-5 text-slate-600">{offer.redemption_instructions}</p>
              <p class="mt-2 border-t border-clubeira-line pt-2 text-xs leading-5 text-slate-500">
                {offer.terms}
              </p>
            </details>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <.link
                :for={place <- offer.places}
                navigate={~p"/explorar/#{@polo.slug}/lugares/#{place.slug}"}
                class="rounded-lg bg-blue-50 px-2.5 py-1.5 text-[11px] font-bold text-blue-700 hover:bg-blue-100"
              >
                {place.name}
              </.link>
            </div>
          </div>
        </article>
      </div>
      <.link
        :if={@benefits_next_page_path}
        id="public-benefits-next-page"
        patch={@benefits_next_page_path}
        class="clubeira-button-secondary mt-6"
      >
        {gettext("More benefits")} <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </section>

    <section :if={@section in ["all", "places"]} id="public-places" class="mt-12">
      <div>
        <p class="clubeira-page-kicker">
          {gettext("Partner network")}
        </p>
        <h2 class="mt-2 text-2xl font-bold tracking-[-0.04em]">{gettext("Places")}</h2>
      </div>
      <div
        id="public-places-stream"
        phx-update="stream"
        class="mt-4 grid gap-3 md:grid-cols-2 xl:grid-cols-3"
      >
        <div
          id="public-places-empty"
          class="hidden only:block rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500 md:col-span-2 xl:col-span-3"
        >
          {gettext("No active partner place is available right now.")}
        </div>
        <article
          :for={{id, place} <- @streams.places}
          id={id}
          class="rounded-xl border border-clubeira-line bg-white p-5 transition hover:border-blue-200"
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-wider text-orange-600">
                {place.address.city.name}
              </p>
              <h3 class="mt-2 text-xl font-bold tracking-[-0.03em]">{place.name}</h3>
            </div>
            <span class="clubeira-icon-tile shrink-0">
              <.icon name="hero-map-pin" class="size-5" />
            </span>
          </div>
          <p class="mt-4 text-sm leading-6 text-slate-500">
            {place.address.street}, {place.address.number || gettext("no number")} · {place.address.district}
          </p>
          <div class="mt-4 flex flex-wrap gap-1.5">
            <span
              :for={brand <- place.brands}
              class="rounded-lg bg-slate-100 px-2 py-1 text-[10px] font-bold text-slate-600"
            >
              {brand.name}
            </span>
          </div>
          <.link
            navigate={~p"/explorar/#{@polo.slug}/lugares/#{place.slug}"}
            class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-blue-700"
          >
            {gettext("View place")} <.icon name="hero-arrow-right" class="size-4" />
          </.link>
        </article>
      </div>
      <.link
        :if={@places_next_page_path}
        id="public-places-next-page"
        patch={@places_next_page_path}
        class="clubeira-button-secondary mt-6"
      >
        {gettext("More places")} <.icon name="hero-arrow-right" class="size-4" />
      </.link>
    </section>
  </main>
  <PublicComponents.footer />
</div>
