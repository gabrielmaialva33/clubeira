<div
  id="browser-password-reset"
  class="clubeira-canvas clubeira-grid-paper grid min-h-screen place-items-center px-5 py-10 sm:px-8"
>
  <main class="mx-auto w-full max-w-lg overflow-hidden rounded-xl border border-clubeira-line border-t-4 border-t-clubeira-orange bg-white p-6 sm:p-8">
    <.link href={~p"/explorar"} class="inline-flex items-center gap-3" aria-label="Clubeira">
      <span class="clubeira-brand-mark">
        <img src={~p"/images/logo.svg"} class="h-5 w-7" alt="" />
      </span>
      <span class="font-bold tracking-[-0.04em]">Clubeira</span>
    </.link>

    <p class="mt-7 text-xs font-bold uppercase tracking-[0.18em] text-orange-600">
      {gettext("Account access")}
    </p>
    <h1 class="mt-2 text-2xl font-bold tracking-[-0.04em]">
      {gettext("Choose a new password")}
    </h1>

    <div
      :if={@error}
      id="browser-password-reset-error"
      role="alert"
      class="mt-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
    >
      {@error}
    </div>

    <div
      :if={@completed?}
      id="password-reset-completed"
      role="status"
      class="mt-6 rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-900"
    >
      {gettext("Your password was updated. You can sign in now.")}
    </div>

    <.form
      :if={@form}
      for={@form}
      id="password-reset-form"
      action={~p"/redefinir-senha"}
      method="post"
      class="mt-7"
    >
      <.input
        field={@form[:password]}
        id="password-reset-password"
        name="password"
        type="password"
        label={gettext("New password")}
        autocomplete="new-password"
        minlength="15"
        required
      />

      <button
        id="password-reset-submit"
        type="submit"
        class="mt-5 inline-flex h-12 w-full items-center justify-center rounded-xl bg-clubeira-orange px-5 text-sm font-bold text-white hover:bg-orange-600"
      >
        {gettext("Update password")}
      </button>
    </.form>

    <p class="mt-6 text-center text-sm text-slate-500">
      <.link href={~p"/app/login"} class="font-bold text-blue-700">
        {gettext("Go to sign in")}
      </.link>
    </p>
  </main>
</div>
