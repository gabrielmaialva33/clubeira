<div id="browser-password-reset" class="min-h-screen bg-[#f4f7fb] px-5 py-10 sm:px-8">
  <main class="mx-auto w-full max-w-lg rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_16px_55px_rgba(15,23,42,.08)] sm:p-9">
    <.link href={~p"/explorar"} class="inline-flex items-center gap-3" aria-label="Clubeira">
      <span class="grid size-11 place-items-center rounded-2xl bg-[#0b2342]">
        <img src={~p"/images/logo.svg"} class="h-7 w-9 brightness-0 invert" alt="" />
      </span>
      <span class="font-black tracking-[-0.04em]">Clubeira</span>
    </.link>

    <p class="mt-9 text-xs font-black uppercase tracking-[0.18em] text-orange-600">
      {gettext("Account access")}
    </p>
    <h1 class="mt-2 text-3xl font-black tracking-[-0.045em]">
      {gettext("Choose a new password")}
    </h1>

    <div
      :if={@error}
      id="browser-password-reset-error"
      role="alert"
      class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
    >
      {@error}
    </div>

    <div
      :if={@completed?}
      id="password-reset-completed"
      role="status"
      class="mt-6 rounded-2xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-900"
    >
      {gettext("Your password was updated. You can sign in now.")}
    </div>

    <.form
      :if={@form}
      for={@form}
      id="password-reset-form"
      action={~p"/redefinir-senha"}
      method="post"
      class="mt-7"
    >
      <.input
        field={@form[:password]}
        id="password-reset-password"
        name="password"
        type="password"
        label={gettext("New password")}
        autocomplete="new-password"
        minlength="15"
        required
      />

      <button
        id="password-reset-submit"
        type="submit"
        class="mt-5 inline-flex h-12 w-full items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-black text-white hover:bg-blue-700"
      >
        {gettext("Update password")}
      </button>
    </.form>

    <p class="mt-6 text-center text-sm text-slate-500">
      <.link href={~p"/app/login"} class="font-black text-blue-700">
        {gettext("Go to sign in")}
      </.link>
    </p>
  </main>
</div>
