<div id="browser-registration" class="min-h-screen bg-[#f4f7fb] px-5 py-10 sm:px-8">
  <main class="mx-auto w-full max-w-xl rounded-3xl border border-slate-200 bg-white p-6 shadow-[0_16px_55px_rgba(15,23,42,.08)] sm:p-9">
    <.link href={~p"/explorar"} class="inline-flex items-center gap-3" aria-label="Clubeira">
      <span class="grid size-11 place-items-center rounded-2xl bg-[#0b2342]">
        <img src={~p"/images/logo.svg"} class="h-7 w-9 brightness-0 invert" alt="" />
      </span>
      <span class="font-black tracking-[-0.04em]">Clubeira</span>
    </.link>

    <p class="mt-9 text-xs font-black uppercase tracking-[0.18em] text-orange-600">
      {gettext("Create your account")}
    </p>
    <h1 class="mt-2 text-3xl font-black tracking-[-0.045em]">{gettext("Join Clubeira")}</h1>
    <p class="mt-3 text-sm leading-6 text-slate-500">
      {gettext("Use one account across every Clubeira polo you join.")}
    </p>

    <div
      :if={@error}
      id="browser-registration-error"
      role="alert"
      class="mt-6 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
    >
      {@error}
    </div>

    <.form
      for={@form}
      id="browser-registration-form"
      action={~p"/registrar"}
      method="post"
      class="mt-7"
    >
      <.input
        field={@form[:email]}
        id="registration-email"
        name="email"
        type="email"
        label={gettext("Email")}
        autocomplete="email"
        required
      />
      <.input
        field={@form[:password]}
        id="registration-password"
        name="password"
        type="password"
        label={gettext("Password")}
        autocomplete="new-password"
        minlength="15"
        required
      />

      <section id="registration-legal-documents" class="my-6 rounded-2xl bg-slate-50 p-4">
        <h2 class="text-sm font-black">{gettext("Legal documents")}</h2>
        <ul class="mt-3 grid gap-2">
          <li
            :for={document <- @documents}
            class="flex items-center justify-between gap-3 text-sm"
          >
            <span>{document_label(document)} · v{document.version}</span>
            <a
              href={~p"/termos"}
              target="_blank"
              rel="noopener noreferrer"
              class="font-black text-blue-700"
            >
              {gettext("Read")}
            </a>
          </li>
        </ul>
      </section>

      <label class="flex items-start gap-3 text-sm leading-6 text-slate-700">
        <input
          id="registration-accept-legal-documents"
          name="accept_legal_documents"
          type="checkbox"
          value="true"
          checked={@accepted?}
          required
          class="mt-1 size-4 rounded border-slate-300 text-blue-600"
        />
        <span>{gettext("I have read and accept all current legal documents above.")}</span>
      </label>

      <button
        id="browser-registration-submit"
        type="submit"
        class="mt-6 inline-flex h-12 w-full items-center justify-center rounded-xl bg-blue-600 px-5 text-sm font-black text-white hover:bg-blue-700"
      >
        {gettext("Create account")}
      </button>
    </.form>

    <p class="mt-6 text-center text-sm text-slate-500">
      {gettext("Already have an account?")}
      <.link href={~p"/app/login"} class="font-black text-blue-700">{gettext("Sign in")}</.link>
    </p>
  </main>
</div>
