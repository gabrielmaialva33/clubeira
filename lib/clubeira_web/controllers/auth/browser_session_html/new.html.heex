<div
  id={@login_id}
  class="min-h-screen bg-[#f4f7fb] lg:grid lg:grid-cols-[minmax(0,1.08fr)_minmax(480px,0.92fr)]"
>
  <section class="relative hidden min-h-screen overflow-hidden bg-[#081b33] px-12 py-10 text-white lg:flex lg:flex-col lg:justify-between xl:px-20 xl:py-14">
    <div class="absolute inset-0 opacity-40 [background-image:linear-gradient(rgba(255,255,255,.045)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,.045)_1px,transparent_1px)] [background-size:44px_44px]" />
    <div class="absolute -right-32 -top-32 size-[32rem] rounded-full bg-blue-500/25 blur-3xl" />
    <div class="absolute -bottom-40 -left-32 size-[30rem] rounded-full bg-orange-500/20 blur-3xl" />

    <div class="relative flex items-center gap-3">
      <span class="grid size-12 place-items-center rounded-2xl bg-white shadow-[0_16px_50px_rgba(0,0,0,.2)]">
        <img src={~p"/images/logo.svg"} class="h-7 w-10" alt="" />
      </span>
      <div>
        <p class="text-xl font-black tracking-[-0.035em]">Clubeira</p>
        <p class="text-xs font-semibold uppercase tracking-[0.24em] text-blue-200">
          {@surface_label}
        </p>
      </div>
    </div>

    <div class="relative max-w-2xl pb-10">
      <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-2 text-xs font-semibold text-blue-100 backdrop-blur">
        <span class="size-2 rounded-full bg-orange-400 shadow-[0_0_0_5px_rgba(251,146,60,.12)]" />
        {gettext("One operation. Every polo in context.")}
      </span>
      <h1 class="mt-7 max-w-xl text-5xl font-black leading-[1.05] tracking-[-0.055em] xl:text-6xl">
        {gettext("Your club operation, clear from end to end.")}
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-8 text-slate-300">
        {gettext(
          "Partners, benefits, subscriptions and finance sharing the same reliable view of the business."
        )}
      </p>

      <div class="mt-10 grid max-w-xl grid-cols-3 gap-3">
        <div class="rounded-2xl border border-white/10 bg-white/[0.055] p-4 backdrop-blur">
          <.icon name="hero-building-storefront" class="size-5 text-orange-400" />
          <p class="mt-5 text-sm font-semibold">{gettext("Partners")}</p>
          <p class="mt-1 text-xs text-slate-400">{gettext("Network and places")}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.055] p-4 backdrop-blur">
          <.icon name="hero-ticket" class="size-5 text-blue-300" />
          <p class="mt-5 text-sm font-semibold">{gettext("Benefits")}</p>
          <p class="mt-1 text-xs text-slate-400">{gettext("Catalog and offers")}</p>
        </div>
        <div class="rounded-2xl border border-white/10 bg-white/[0.055] p-4 backdrop-blur">
          <.icon name="hero-chart-bar-square" class="size-5 text-cyan-300" />
          <p class="mt-5 text-sm font-semibold">{gettext("Finance")}</p>
          <p class="mt-1 text-xs text-slate-400">{gettext("Payments and cycles")}</p>
        </div>
      </div>
    </div>

    <p class="relative text-xs text-slate-500">
      {gettext("Secure tenant isolation, audited actions and real-time authorization.")}
    </p>
  </section>

  <main class="flex min-h-screen items-center justify-center px-5 py-10 sm:px-10 lg:px-14">
    <div class="w-full max-w-[430px]">
      <div class="mb-10 flex items-center gap-3 lg:hidden">
        <span class="grid size-11 place-items-center rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
          <img src={~p"/images/logo.svg"} class="h-7 w-9" alt="" />
        </span>
        <div>
          <p class="text-lg font-black tracking-[-0.035em] text-slate-950">Clubeira</p>
          <p class="text-[10px] font-bold uppercase tracking-[0.22em] text-blue-600">
            {@surface_label}
          </p>
        </div>
      </div>

      <div>
        <p class="text-sm font-bold text-orange-600">{@form_eyebrow}</p>
        <h2 class="mt-2 text-3xl font-black tracking-[-0.045em] text-slate-950">
          {@form_heading}
        </h2>
        <p class="mt-3 text-sm leading-6 text-slate-500">
          {@form_description}
        </p>
      </div>

      <div
        :if={@error}
        id="login-error"
        role="alert"
        class="mt-7 flex items-start gap-3 rounded-2xl border border-red-200 bg-red-50 px-4 py-3.5 text-sm text-red-800"
      >
        <.icon name="hero-exclamation-circle" class="mt-0.5 size-5 shrink-0" />
        <span>{@error}</span>
      </div>

      <.form
        for={@form}
        id={@login_form_id}
        action={@form_action}
        method="post"
        class="mt-8"
      >
        <.input
          field={@form[:email]}
          id="login-email"
          type="email"
          label={gettext("Email")}
          autocomplete="email"
          placeholder="voce@empresa.com.br"
          required
          class="block h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
        />
        <.input
          field={@form[:password]}
          id="login-password"
          type="password"
          label={gettext("Password")}
          autocomplete="current-password"
          placeholder="••••••••••••"
          required
          class="block h-12 w-full rounded-xl border border-slate-200 bg-white px-4 text-slate-950 shadow-sm outline-none transition placeholder:text-slate-400 hover:border-slate-300 focus:border-blue-500 focus:ring-4 focus:ring-blue-100"
        />

        <button
          id="login-submit"
          type="submit"
          class="mt-2 inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 text-sm font-bold text-white shadow-[0_12px_28px_rgba(37,99,235,.24)] transition hover:-translate-y-0.5 hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 active:translate-y-0"
        >
          {@submit_label}
          <.icon name="hero-arrow-right" class="size-4" />
        </button>
      </.form>

      <nav
        :if={@login_id == "member-login"}
        id="member-auth-links"
        class="mt-5 flex items-center justify-between gap-4 text-sm"
        aria-label={gettext("Member account")}
      >
        <.link id="member-register-link" href={~p"/registrar"} class="font-bold text-blue-700">
          {gettext("Create account")}
        </.link>
        <.link
          id="member-password-reset-link"
          href={~p"/esqueci-minha-senha"}
          class="font-bold text-blue-700"
        >
          {gettext("Forgot password?")}
        </.link>
      </nav>

      <div class="mt-8 flex items-center justify-between border-t border-slate-200 pt-6 text-xs text-slate-400">
        <span>{gettext("Protected environment")}</span>
        <span class="inline-flex items-center gap-1.5 font-semibold text-slate-500">
          <.icon name="hero-lock-closed" class="size-3.5 text-blue-600" />
          {gettext("Encrypted session")}
        </span>
      </div>
    </div>
  </main>
</div>
