<div id={@login_id} class="clubeira-canvas clubeira-grid-paper min-h-screen text-clubeira-ink">
  <header class="border-b border-clubeira-line bg-white/95">
    <div class="mx-auto flex h-[68px] max-w-6xl items-center justify-between px-5 sm:px-8">
      <.link href={~p"/explorar"} class="flex items-center gap-3" aria-label="Clubeira">
        <span class="clubeira-brand-mark">
          <img src={~p"/images/logo.svg"} class="h-5 w-7" alt="" />
        </span>
        <div>
          <p class="text-[17px] font-black leading-none tracking-[-0.04em]">Clubeira</p>
          <p class="mt-1 text-[9px] font-bold uppercase tracking-[0.22em] text-clubeira-orange">
            {@surface_label}
          </p>
        </div>
      </.link>

      <span class="hidden items-center gap-2 rounded-lg bg-clubeira-blue-soft px-3 py-2 text-[11px] font-bold text-clubeira-blue sm:inline-flex">
        <.icon name="hero-lock-closed" class="size-3.5" />
        {gettext("Protected environment")}
      </span>
    </div>
  </header>

  <main class="mx-auto grid min-h-[calc(100vh-68px)] w-full max-w-6xl place-items-center px-5 py-10 sm:px-8">
    <section class="w-full max-w-md overflow-hidden rounded-xl border border-clubeira-line bg-white">
      <div class="h-1 bg-clubeira-orange" />

      <div class="p-6 sm:p-8">
        <div class="flex items-start justify-between gap-5">
          <div>
            <p class="clubeira-page-kicker">{@form_eyebrow}</p>
            <h1 class="mt-2 text-2xl font-bold tracking-[-0.04em] text-clubeira-ink">
              {@form_heading}
            </h1>
          </div>
          <span class="clubeira-icon-tile shrink-0">
            <.icon name="hero-arrow-right-end-on-rectangle" class="size-5" />
          </span>
        </div>

        <p class="mt-3 max-w-sm text-sm leading-6 text-clubeira-muted">
          {@form_description}
        </p>

        <div
          :if={@error}
          id="login-error"
          role="alert"
          class="mt-6 flex items-start gap-3 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
        >
          <.icon name="hero-exclamation-circle" class="mt-0.5 size-5 shrink-0" />
          <span>{@error}</span>
        </div>

        <.form
          for={@form}
          id={@login_form_id}
          action={@form_action}
          method="post"
          class="mt-7"
        >
          <.input
            field={@form[:email]}
            id="login-email"
            type="email"
            label={gettext("Email")}
            autocomplete="email"
            placeholder="voce@empresa.com.br"
            required
            class="clubeira-control"
          />
          <.input
            field={@form[:password]}
            id="login-password"
            type="password"
            label={gettext("Password")}
            autocomplete="current-password"
            placeholder="••••••••••••"
            required
            class="clubeira-control"
          />

          <button id="login-submit" type="submit" class="clubeira-button-primary mt-2 w-full">
            {@submit_label}
            <.icon name="hero-arrow-right" class="size-4" />
          </button>
        </.form>

        <nav
          :if={@login_id == "member-login"}
          id="member-auth-links"
          class="mt-5 flex items-center justify-between gap-4 text-sm"
          aria-label={gettext("Member account")}
        >
          <.link
            id="member-register-link"
            href={~p"/registrar"}
            class="font-bold text-clubeira-blue hover:underline"
          >
            {gettext("Create account")}
          </.link>
          <.link
            id="member-password-reset-link"
            href={~p"/esqueci-minha-senha"}
            class="font-bold text-clubeira-blue hover:underline"
          >
            {gettext("Forgot password?")}
          </.link>
        </nav>
      </div>

      <div class="flex items-center justify-between gap-4 border-t border-clubeira-line bg-clubeira-canvas px-6 py-4 text-[11px] text-clubeira-muted sm:px-8">
        <span class="inline-flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-emerald-500" />
          {gettext("Encrypted session")}
        </span>
        <span class="font-bold text-clubeira-ink">{@surface_label}</span>
      </div>
    </section>
  </main>
</div>
