# Local-only development credentials provisioned by compose.yaml.
CLUBEIRA_POSTGRES_PORT=55432
CLUBEIRA_DATABASE_URL=ecto://clubeira_app:clubeira_app@localhost:55432/clubeira_dev
CLUBEIRA_MIGRATOR_DATABASE_URL=ecto://clubeira_migrator:clubeira_migrator@localhost:55432/clubeira_dev

# Tests connect as the local PostgreSQL administrator, then assume a temporary
# NOSUPERUSER NOBYPASSRLS role inside each SQL sandbox transaction.
CLUBEIRA_TEST_DB_HOST=localhost
CLUBEIRA_TEST_DB_PORT=55432
CLUBEIRA_TEST_DB_USER=postgres
CLUBEIRA_TEST_DB_PASSWORD=postgres

# The Mercado Pago sandbox only accepts payer e-mails from a test user. Keep
# the default for offline development or replace it before running the seeds.
# CLUBEIRA_DEMO_EMAIL=TESTUSER_ID@testuser.com
# CLUBEIRA_DEMO_PASSWORD=clubeira-demo-local
# Demo-only validation API key. Generate 32 random bytes as unpadded base64url
# before exposing a shared development environment.
# CLUBEIRA_DEMO_VALIDATION_SECRET=M-bCcLGupP8XuBxzemHd-4JumJf6trsiQpinEl30xwg

# Credentials stay in runtime configuration, never in PostgreSQL. The object
# key must match merchant_accounts.provider_account_reference; demo seeds use
# mercado-pago-demo. Multiple merchant accounts may coexist in the same JSON.
# MERCADO_PAGO_ACCOUNTS_JSON='{"mercado-pago-demo":{"access_token":"APP_USR_REPLACE_ME","webhook_secret":"replace-with-a-webhook-secret-of-at-least-32-bytes"}}'

# Production runtime tuning. These values are ignored by the development
# config; calibrate Argon2 against the real deployment before overriding them.
# ARGON2_T_COST=3
# ARGON2_M_COST=16
# ARGON2_PARALLELISM=4
# ARGON2_MAX_CONCURRENCY=8
# LOGIN_RATE_GLOBAL_PER_SECOND=40
# LOGIN_RATE_IP_PER_MINUTE=20
# LOGIN_RATE_IDENTITY_PER_15_MINUTES=10
# REGISTRATION_RATE_GLOBAL_PER_SECOND=10
# REGISTRATION_RATE_IP_PER_MINUTE=5
# REGISTRATION_RATE_IDENTITY_PER_15_MINUTES=3
# REDEMPTION_GRANT_MAX_AGE_SECONDS=120
# SESSION_RETENTION_DAYS=30
